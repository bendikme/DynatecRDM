<Window x:Class="DynatecRDM.Views.MultiConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        mc:Ignorable="po"
        Title="Multi-config"
        Style="{StaticResource AppWindowStyle}"
        Width="1220"
        Height="830"
        MinWidth="1020"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- Icons. 24x24 stroked paths, kept local to this window so nothing collides.
             Frozen: every Path below shares one instance, and a frozen geometry costs nothing
             to hand to a recycled list item. -->
        <PathGeometry x:Key="MceArrowUp" po:Freeze="True" Figures="M 12,19 L 12,6 M 6,12 L 12,6 L 18,12" />
        <PathGeometry x:Key="MceArrowDown" po:Freeze="True" Figures="M 12,5 L 12,18 M 6,12 L 12,18 L 18,12" />
        <PathGeometry x:Key="McePlus" po:Freeze="True" Figures="M 12,5 L 12,19 M 5,12 L 19,12" />
        <PathGeometry x:Key="MceTrash" po:Freeze="True" Figures="M 4,7 L 20,7 M 10,7 L 10,4 L 14,4 L 14,7 M 6,7 L 7,20 L 17,20 L 18,7 M 10,10 L 10,17 M 14,10 L 14,17" />
        <PathGeometry x:Key="MceCopy" po:Freeze="True" Figures="M 9,8 L 9,20 L 19,20 L 19,8 Z M 5,16 L 5,4 L 15,4 L 15,7" />
        <PathGeometry x:Key="MceSearch" po:Freeze="True" Figures="M 4,11 A 7,7 0 1 1 18,11 A 7,7 0 1 1 4,11 M 16.2,16.2 L 21,21" />
        <PathGeometry x:Key="MceAlert" po:Freeze="True" Figures="M 12,4 L 21.5,20 L 2.5,20 Z M 12,10 L 12,15 M 12,17.2 L 12,18.2" />
        <PathGeometry x:Key="MceMonitor" po:Freeze="True" Figures="M 3,5 L 21,5 L 21,16 L 3,16 Z M 9,20 L 15,20 M 12,16 L 12,20" />
        <PathGeometry x:Key="McePlay" po:Freeze="True" Figures="M 8,5 L 19,12 L 8,19 Z" />
        <PathGeometry x:Key="MceSlash" po:Freeze="True" Figures="M 4,20 L 20,4" />
        <PathGeometry x:Key="MceReset" po:Freeze="True" Figures="M 20,12 A 8,8 0 1 1 17,5.8 M 17,2 L 17,6.2 L 12.8,6.2" />

        <!-- Tool tips in this window follow the app theme. -->
        <Style TargetType="ToolTip" BasedOn="{StaticResource AppToolTipStyle}" />

        <Style x:Key="MceLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MceHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MceFieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="130" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MceRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MceInherit" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBoxStyle}">
            <Setter Property="Content" Value="Use connection setting" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="MceValueCombo" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Width" Value="210" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MceSmallCombo" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Width" Value="96" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MceNumberBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Width" Value="84" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MceTinyNumberBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Width" Value="60" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MceValueToggle" TargetType="CheckBox" BasedOn="{StaticResource AppToggleStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="210" />
        </Style>

        <Style x:Key="MceAxisLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="14" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <!-- Colour swatch: a filled square with an accent ring when it is the chosen colour. -->
        <Style x:Key="MceSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Ring"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    SnapsToDevicePixels="True" />
                            <Border x:Name="Fill"
                                    Margin="3"
                                    Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}, ConverterParameter=#22262E}"
                                    BorderBrush="{StaticResource BorderBrushStrong}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="NoColour"
                                      Data="{StaticResource MceSlash}"
                                      Stretch="Uniform"
                                      Margin="4"
                                      Stroke="{StaticResource TextMutedBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasColor}" Value="False">
                                <Setter TargetName="NoColour" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One monitor rectangle on the layout map. -->
        <Style x:Key="MceMonitorCell" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A single item shown inside a monitor rectangle. -->
        <DataTemplate x:Key="MceChipTemplate">
            <Border Margin="0,0,4,4"
                    Padding="6,1"
                    MaxWidth="132"
                    CornerRadius="3"
                    BorderThickness="1"
                    Background="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}, ConverterParameter=#2E3947}"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                        <Setter Property="Opacity" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsItemEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Name}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ TOP -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="12,12,12,0">
            <StackPanel>

                <TextBlock Text="{Binding HeaderText}"
                           FontSize="{StaticResource FontSizeLarge}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource MceHint}"
                           Text="A multi-config starts several connections together and puts each one on the screen you choose."
                           Margin="0,0,0,12" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" MinWidth="200" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource MceLabel}" Text="Name" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                 MaxLength="80"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource MceLabel}" Text="Description" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                 MaxLength="240"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Width="190">
                        <TextBlock Style="{StaticResource MceLabel}" Text="Group" />
                        <ComboBox Style="{StaticResource AppComboBoxStyle}"
                                  ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource MceLabel}" Text="Favourite" />
                        <Border Height="30" Background="Transparent">
                            <CheckBox Style="{StaticResource AppToggleStyle}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Favorite}"
                                      Content="Keep near the top" />
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource MceFieldLabel}" Width="60" Text="Colour" />
                    <ItemsControl ItemsSource="{Binding ColorSwatches}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MceSwatchButton}"
                                        ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Style="{StaticResource AppSeparatorStyle}" Margin="0,2,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  IsChecked="{Binding Sequential}"
                                  Content="Start them one after another" />
                        <TextBlock Style="{StaticResource MceHint}"
                                   Margin="48,4,0,0"
                                   Text="Sequential waits for each session window to appear before starting the next one, so the screens fill up in a predictable order. Switch it off to fire everything at once." />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource MceLabel}" Text="Initial delay (ms)" />
                        <TextBox Style="{StaticResource MceNumberBox}"
                                 HorizontalAlignment="Left"
                                 ToolTip="Time to wait before the first session starts"
                                 Text="{Binding InitialDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Top" MaxWidth="240">
                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  IsChecked="{Binding CloseTogether}"
                                  Content="Close them together" />
                        <TextBlock Style="{StaticResource MceHint}"
                                   Margin="48,4,0,0"
                                   Text="Closing any session in the set closes the rest." />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ============================================================ BODY -->
        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="290" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ LEFT: items -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="CONNECTIONS IN THIS SET" />
                        <TextBlock Style="{StaticResource MceHint}"
                                   Margin="0,0,0,8"
                                   Text="They start in this order. Untick one to keep it in the set without launching it." />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource AppListBoxStyle}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Width="18"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding Position}" />

                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource AppCheckBoxStyle}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Enabled}"
                                              ToolTip="Launch this connection with the set" />

                                    <Border Grid.Column="2"
                                            Width="3"
                                            Margin="8,2,0,2"
                                            CornerRadius="2"
                                            Background="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}, ConverterParameter=#3A414D}" />

                                    <StackPanel Grid.Column="3" Margin="8,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource MceAlert}"
                                                  Width="12"
                                                  Height="12"
                                                  Margin="0,0,5,0"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Stroke="{StaticResource DangerBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineJoin="Round"
                                                  Visibility="{Binding IsMissing, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Host}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                ToolTip="Move up"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource MceArrowUp}"
                                                  Width="12"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                Margin="0,2,0,0"
                                                ToolTip="Move down"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource MceArrowDown}"
                                                  Width="12"
                                                  Height="12"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AddButton"
                                Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                Command="{Binding OpenPickerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource McePlus}"
                                      Width="12"
                                      Height="12"
                                      Margin="0,0,6,0"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Text="Add connection..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="Remove the selected item"
                                Command="{Binding RemoveCommand}">
                            <Path Data="{StaticResource MceTrash}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="4,0,0,0"
                                ToolTip="Duplicate the selected item"
                                Command="{Binding DuplicateCommand}">
                            <Path Data="{StaticResource MceCopy}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>

                        <!-- Inline connection picker -->
                        <Popup x:Name="PickerPopup"
                               Grid.Column="0"
                               Width="340"
                               AllowsTransparency="True"
                               Placement="Top"
                               PlacementTarget="{Binding ElementName=AddButton}"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
                               Opened="OnPickerOpened">
                            <Border Margin="0,0,0,6"
                                    Padding="10"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushStrong}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="{StaticResource MceSearch}"
                                              Width="13"
                                              Height="13"
                                              Margin="2,0,8,0"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Stroke="{StaticResource TextMutedBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                        <TextBox x:Name="PickerSearchBox"
                                                 Grid.Column="1"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource MceHint}"
                                               Margin="0,8,0,0"
                                               Text="{Binding PickerEmptyText}"
                                               Visibility="{Binding PickerEmptyText, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                                    <ListBox x:Name="PickerList"
                                             Grid.Row="2"
                                             Margin="0,8,0,0"
                                             MaxHeight="260"
                                             Style="{StaticResource AppListBoxStyle}"
                                             ItemsSource="{Binding PickerResults}"
                                             SelectedItem="{Binding PickerSelection, Mode=TwoWay}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             MouseDoubleClick="OnPickerItemDoubleClick">
                                        <ListBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddSelectedCommand}" />
                                        </ListBox.InputBindings>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="3"
                                                            Margin="0,2,8,2"
                                                            CornerRadius="2"
                                                            Background="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}, ConverterParameter=#3A414D}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock FontSize="{StaticResource FontSizeSmall}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Host, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding GroupName, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                        <Button Style="{StaticResource SubtleButtonStyle}"
                                                Content="Close"
                                                MinWidth="70"
                                                Command="{Binding ClosePickerCommand}" />
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Add"
                                                MinWidth="70"
                                                Margin="8,0,0,0"
                                                Command="{Binding AddSelectedCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <!-- ============================================================ RIGHT: map and overrides -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Path Data="{StaticResource MceMonitor}"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,7,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineJoin="Round" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       Text="LAYOUT MAP" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MceHint}"
                                   Margin="0,0,0,8"
                                   Text="Your screens, with the sessions that will land on each. Click a screen to put the selected item full screen on it." />

                        <Border HorizontalAlignment="Center"
                                Background="{StaticResource BackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMedium}">
                            <Grid Width="{Binding MapCanvasWidth}"
                                  Height="{Binding MapCanvasHeight}"
                                  ClipToBounds="True">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding MapEmptyText}"
                                           Visibility="{Binding MapEmptyText, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                                <ItemsControl ItemsSource="{Binding MonitorCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MceMonitorCell}"
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    ToolTip="Put the selected item full screen on this screen"
                                                    Command="{Binding DataContext.AssignMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Index}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                        <Border Style="{StaticResource StatusPillStyle}"
                                                                Padding="7,0"
                                                                MinHeight="17">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <ItemsControl Grid.Row="1"
                                                                  Margin="0,5,0,0"
                                                                  ItemsSource="{Binding Chips}"
                                                                  ItemTemplate="{StaticResource MceChipTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding UnplacedItems.Count, Converter={x:Static conv:CountToVisibilityConverter.Instance}}">
                            <TextBlock Style="{StaticResource MceHint}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="Not pinned to a screen:" />
                            <ItemsControl ItemsSource="{Binding UnplacedItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,0"
                                                Padding="6,1"
                                                MaxWidth="150"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                Background="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}, ConverterParameter=#22262E}">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="360"
                                   Text="Select an item on the left to give it its own screen placement, credential or label."
                                   Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                        <ScrollViewer Style="{StaticResource AppScrollViewerStyle}"
                                      Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <StackPanel DataContext="{Binding SelectedItem}" Margin="0,0,10,0">

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               FontSize="{StaticResource FontSizeMedium}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            MinWidth="0"
                                            Padding="8,4"
                                            ToolTip="Drop every override and use the connection's own settings"
                                            Command="{Binding DataContext.ClearOverridesCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource MceReset}"
                                                  Width="12"
                                                  Height="12"
                                                  Margin="0,0,6,0"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <TextBlock Text="Reset overrides" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Style="{StaticResource MceHint}"
                                           Margin="0,0,0,14"
                                           Text="Every field below starts out inherited from the connection itself. Clear 'Use connection setting' and the field becomes editable - the value then applies to this multi-config only." />

                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="WHERE THIS SESSION GOES" />

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Screen mode" />
                                    <ComboBox Style="{StaticResource MceValueCombo}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              ItemsSource="{Binding DataContext.ScreenModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding ScreenMode}"
                                              IsEnabled="{Binding InheritScreenMode, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritScreenMode}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Placement" />
                                    <ComboBox Style="{StaticResource MceValueCombo}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Value"
                                              ItemsSource="{Binding DataContext.PlacementOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding Placement}"
                                              IsEnabled="{Binding InheritPlacement, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritPlacement}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Target monitor" />
                                    <ComboBox Style="{StaticResource MceValueCombo}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Index"
                                              ItemsSource="{Binding DataContext.Monitors, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding TargetMonitorIndex}"
                                              IsEnabled="{Binding InheritTargetMonitor, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritTargetMonitor}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Style="{StaticResource MceRow}" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource MceFieldLabel}" Text="Selected monitors" />
                                        <CheckBox Style="{StaticResource MceInherit}"
                                                  Margin="0"
                                                  IsChecked="{Binding InheritSelectedMonitors}" />
                                    </StackPanel>
                                    <ItemsControl Margin="140,0,0,0"
                                                  ItemsSource="{Binding MonitorToggles}"
                                                  IsEnabled="{Binding InheritSelectedMonitors, Converter={x:Static conv:InverseBoolConverter.Instance}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource AppCheckBoxStyle}"
                                                          Margin="0,0,14,4"
                                                          Content="{Binding Label}"
                                                          IsChecked="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Use all monitors" />
                                    <CheckBox Style="{StaticResource MceValueToggle}"
                                              Content="Span the whole desktop"
                                              IsChecked="{Binding UseAllMonitors}"
                                              IsEnabled="{Binding InheritUseAllMonitors, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritUseAllMonitors}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Always on top" />
                                    <CheckBox Style="{StaticResource MceValueToggle}"
                                              Content="Keep above other windows"
                                              IsChecked="{Binding AlwaysOnTop}"
                                              IsEnabled="{Binding InheritAlwaysOnTop, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritAlwaysOnTop}" />
                                </StackPanel>

                                <Border Style="{StaticResource AppSeparatorStyle}" Margin="0,6,0,12" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="DESKTOP SIZE AND QUALITY" />

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Desktop size" />
                                    <TextBox Style="{StaticResource MceNumberBox}"
                                             Text="{Binding DesktopWidth, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding InheritDesktopSize, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <TextBlock Text="x"
                                               Margin="7,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBox Style="{StaticResource MceNumberBox}"
                                             Text="{Binding DesktopHeight, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding InheritDesktopSize, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritDesktopSize}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Colour depth" />
                                    <ComboBox Style="{StaticResource MceSmallCombo}"
                                              ItemsSource="{Binding DataContext.ColorDepthOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding ColorDepth}"
                                              IsEnabled="{Binding InheritColorDepth, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <TextBlock Text="bits"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritColorDepth}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Scale factor" />
                                    <ComboBox Style="{StaticResource MceSmallCombo}"
                                              ItemsSource="{Binding DataContext.ScaleFactorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DesktopScaleFactor}"
                                              IsEnabled="{Binding InheritScaleFactor, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <TextBlock Text="per cent"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritScaleFactor}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Smart sizing" />
                                    <CheckBox Style="{StaticResource MceValueToggle}"
                                              Content="Scale the remote desktop to the window"
                                              IsChecked="{Binding SmartSizing}"
                                              IsEnabled="{Binding InheritSmartSizing, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritSmartSizing}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Dynamic resolution" />
                                    <CheckBox Style="{StaticResource MceValueToggle}"
                                              Content="Resize the session with the window"
                                              IsChecked="{Binding DynamicResolution}"
                                              IsEnabled="{Binding InheritDynamicResolution, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritDynamicResolution}" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Style="{StaticResource MceRow}" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource MceFieldLabel}" Text="Custom rectangle" />
                                        <CheckBox Style="{StaticResource MceInherit}"
                                                  Margin="0"
                                                  IsChecked="{Binding InheritCustomRect}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="140,0,0,0"
                                                IsEnabled="{Binding InheritCustomRect, Converter={x:Static conv:InverseBoolConverter.Instance}}">
                                        <TextBlock Style="{StaticResource MceAxisLabel}" Text="L" />
                                        <TextBox Style="{StaticResource MceTinyNumberBox}"
                                                 Margin="0,0,8,0"
                                                 Text="{Binding CustomLeft, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource MceAxisLabel}" Text="T" />
                                        <TextBox Style="{StaticResource MceTinyNumberBox}"
                                                 Margin="0,0,8,0"
                                                 Text="{Binding CustomTop, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource MceAxisLabel}" Text="W" />
                                        <TextBox Style="{StaticResource MceTinyNumberBox}"
                                                 Margin="0,0,8,0"
                                                 Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource MceAxisLabel}" Text="H" />
                                        <TextBox Style="{StaticResource MceTinyNumberBox}"
                                                 Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource AppSeparatorStyle}" Margin="0,6,0,12" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="THIS ITEM ONLY" />

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Display name" />
                                    <TextBox Style="{StaticResource AppTextBoxStyle}"
                                             Width="260"
                                             MaxLength="60"
                                             VerticalAlignment="Center"
                                             ToolTip="Leave blank to use the connection's own name"
                                             Text="{Binding DisplayNameText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Credential set" />
                                    <ComboBox Style="{StaticResource MceValueCombo}"
                                              Width="260"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              ItemsSource="{Binding DataContext.CredentialOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding CredentialSelection}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Auto-reconnect" />
                                    <CheckBox Style="{StaticResource MceValueToggle}"
                                              Content="Bring this session back if it drops"
                                              IsChecked="{Binding AutoReconnect}"
                                              IsEnabled="{Binding InheritAutoReconnect, Converter={x:Static conv:InverseBoolConverter.Instance}}" />
                                    <CheckBox Style="{StaticResource MceInherit}" IsChecked="{Binding InheritAutoReconnect}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource MceRow}">
                                    <TextBlock Style="{StaticResource MceFieldLabel}" Text="Delay after (ms)" />
                                    <TextBox Style="{StaticResource MceNumberBox}"
                                             ToolTip="How long to wait after this item before the next one starts"
                                             Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource MceHint}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Only used when the set starts sequentially." />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ BOTTOM -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasError, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Path Data="{StaticResource MceAlert}"
                              Width="14"
                              Height="14"
                              Margin="0,0,7,0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Stroke="{StaticResource DangerBrush}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="{Binding ErrorText}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasWarning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Path Data="{StaticResource MceAlert}"
                              Width="14"
                              Height="14"
                              Margin="0,0,7,0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Stroke="{StaticResource WarningBrush}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="{Binding WarningText}"
                                   Foreground="{StaticResource WarningBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding InfoText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding InfoText, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            MinWidth="112"
                            ToolTip="Save the set and start every enabled item now"
                            Command="{Binding LaunchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource McePlay}"
                                  Width="11"
                                  Height="11"
                                  Margin="0,0,7,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{StaticResource SuccessBrush}" />
                            <TextBlock Text="Launch now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Content="Save"
                            Command="{Binding SaveCommand}" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
