<Window x:Class="DynatecRDM.Views.MultiConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        xmlns:res="clr-namespace:DynatecRDM.Resources"
        xmlns:views="clr-namespace:DynatecRDM.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        mc:Ignorable="po"
        Title="{Binding HeaderText}"
        Style="{StaticResource AppWindowStyle}"
        Width="1320"
        Height="880"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterOwner">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- Icons. 24x24 stroked paths, kept local to this window so nothing collides.
             Frozen: every Path below shares one instance, and a frozen geometry costs nothing
             to hand to a recycled list item. -->
        <PathGeometry x:Key="MceArrowUp" po:Freeze="True" Figures="M 12,19 L 12,6 M 6,12 L 12,6 L 18,12" />
        <PathGeometry x:Key="MceArrowDown" po:Freeze="True" Figures="M 12,5 L 12,18 M 6,12 L 12,18 L 18,12" />
        <PathGeometry x:Key="McePlus" po:Freeze="True" Figures="M 12,5 L 12,19 M 5,12 L 19,12" />
        <PathGeometry x:Key="MceTrash" po:Freeze="True" Figures="M 4,7 L 20,7 M 10,7 L 10,4 L 14,4 L 14,7 M 6,7 L 7,20 L 17,20 L 18,7 M 10,10 L 10,17 M 14,10 L 14,17" />
        <PathGeometry x:Key="MceCopy" po:Freeze="True" Figures="M 9,8 L 9,20 L 19,20 L 19,8 Z M 5,16 L 5,4 L 15,4 L 15,7" />
        <PathGeometry x:Key="MceSearch" po:Freeze="True" Figures="M 4,11 A 7,7 0 1 1 18,11 A 7,7 0 1 1 4,11 M 16.2,16.2 L 21,21" />
        <PathGeometry x:Key="MceAlert" po:Freeze="True" Figures="M 12,4 L 21.5,20 L 2.5,20 Z M 12,10 L 12,15 M 12,17.2 L 12,18.2" />
        <PathGeometry x:Key="McePlay" po:Freeze="True" Figures="M 8,5 L 19,12 L 8,19 Z" />
        <PathGeometry x:Key="MceSlash" po:Freeze="True" Figures="M 4,20 L 20,4" />
        <PathGeometry x:Key="MceReset" po:Freeze="True" Figures="M 20,12 A 8,8 0 1 1 17,5.8 M 17,2 L 17,6.2 L 12.8,6.2" />

        <!-- Tool tips in this window follow the app theme. -->
        <Style TargetType="ToolTip" BasedOn="{StaticResource AppToolTipStyle}" />

        <!-- The display settings sit in the properties panel, which is a card already: its
             sections are spaced, not framed, so every label lines up with the item's own rows. -->
        <Style x:Key="DisplaySectionStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
        <Style x:Key="DisplaySummaryStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="MceLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MceHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MceToggle" TargetType="CheckBox" BasedOn="{StaticResource AppToggleStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,28,0" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        </Style>

        <!-- Colour swatch: a filled square with an accent ring when it is the chosen colour. -->
        <Style x:Key="MceSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Ring"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    SnapsToDevicePixels="True" />
                            <Border x:Name="Fill"
                                    Margin="3"
                                    Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                    BorderBrush="{DynamicResource BorderBrushStrong}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="NoColour"
                                      Data="{StaticResource MceSlash}"
                                      Stretch="Uniform"
                                      Margin="4"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasColor}" Value="False">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="NoColour" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A connection's colour as a thin stripe, or a quiet neutral when it has none. -->
        <Style x:Key="MceColourStripe" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource BorderBrushSoft}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorHex, Converter={x:Static conv:IsColorConverter.Instance}}" Value="True">
                    <Setter Property="Background" Value="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The number an item carries in the list and on its chip on the map. -->
        <Style x:Key="MceNumberBadge" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorHex, Converter={x:Static conv:IsColorConverter.Instance}}" Value="True">
                    <Setter Property="Background" Value="{Binding ColorHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ TOP: the set itself -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="12,12,12,0" Padding="14,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" MinWidth="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource MceLabel}" Text="{x:Static res:Strings.Multi_Name_Label}" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                 MaxLength="80"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource MceLabel}" Text="{x:Static res:Strings.Multi_Description_Label}" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                 MaxLength="240"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource MceLabel}" Text="{x:Static res:Strings.Multi_Group_Label}" />
                        <ComboBox Style="{StaticResource AppComboBoxStyle}"
                                  ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource MceLabel}" Text="{x:Static res:Strings.Multi_Colour_Label}" />
                        <ItemsControl ItemsSource="{Binding ColorSwatches}" Height="30" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MceSwatchButton}"
                                            ToolTip="{Binding Name}"
                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- How the set starts and ends. The longer explanations are the tool tips. -->
                <WrapPanel Margin="0,12,0,0">
                    <CheckBox Style="{StaticResource MceToggle}"
                              IsChecked="{Binding Sequential}"
                              ToolTip="{x:Static res:Strings.Multi_Sequential_Hint}"
                              Content="{x:Static res:Strings.Multi_Sequential_Toggle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,28,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.Multi_InitialDelay_Label}"
                                   Style="{StaticResource EditorLabelStyle}"
                                   Margin="0,0,10,0" />
                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                 Width="84"
                                 ToolTip="{x:Static res:Strings.Multi_InitialDelay_Tooltip}"
                                 Text="{Binding InitialDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource MceToggle}"
                              IsChecked="{Binding CloseTogether}"
                              ToolTip="{x:Static res:Strings.Multi_CloseTogether_Hint}"
                              Content="{x:Static res:Strings.Multi_CloseTogether_Toggle}" />
                    <CheckBox Style="{StaticResource MceToggle}"
                              IsChecked="{Binding Favorite}"
                              ToolTip="{x:Static res:Strings.Multi_Favorite_Label}"
                              Content="{x:Static res:Strings.Multi_Favorite_Toggle}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ============================================================ BODY -->
        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="540" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="500" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== LEFT: map over the items -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="220" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="2*" MinHeight="180" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Multi_Map_Header}" />
                            <TextBlock Style="{StaticResource MceHint}" Text="{x:Static res:Strings.Multi_Map_Intro}" />
                        </StackPanel>

                        <!-- The selected item's map: its monitors, and its window when it has a
                             rectangle. Every item is drawn over it; a name selects that item. -->
                        <views:MonitorMapView x:Name="SetMap"
                                              Grid.Row="1"
                                              DataContext="{Binding SelectedDisplay}"
                                              Companions="{Binding DataContext.MapShapes, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CompanionCommand="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource MceHint}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Strings.Multi_Error_NoItems}"
                                   Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource EditorHintStyle}"
                                   Margin="0,8,0,0"
                                   Text="{Binding SelectedDisplay.MapHint}"
                                   Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Multi_Items_Header}" />
                            <TextBlock Style="{StaticResource MceHint}" Text="{x:Static res:Strings.Multi_Items_Hint}" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource AppListBoxStyle}"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource AppCheckBoxStyle}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Enabled}"
                                                  ToolTip="{x:Static res:Strings.Multi_Item_Enabled_Tooltip}" />

                                        <!-- The same number and colour as the item's chip on the map. -->
                                        <Border Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" Style="{StaticResource MceNumberBadge}">
                                            <TextBlock Text="{Binding Position}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding ColorHex, Converter={x:Static conv:ContrastForegroundConverter.Instance}, FallbackValue=White}" />
                                        </Border>

                                        <Grid Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MaxWidth="260" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                <Path Data="{StaticResource MceAlert}"
                                                      Width="12"
                                                      Height="12"
                                                      Margin="0,0,5,0"
                                                      Stretch="Uniform"
                                                      VerticalAlignment="Center"
                                                      Stroke="{DynamicResource DangerBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeLineJoin="Round"
                                                      Visibility="{Binding IsMissing, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{Binding Host}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                       Margin="16,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Summary}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="26"
                                                    Height="26"
                                                    ToolTip="{x:Static res:Strings.Multi_Item_MoveUp_Tooltip}"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource MceArrowUp}"
                                                      Width="12"
                                                      Height="12"
                                                      Stretch="Uniform"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Width="26"
                                                    Height="26"
                                                    Margin="2,0,0,0"
                                                    ToolTip="{x:Static res:Strings.Multi_Item_MoveDown_Tooltip}"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource MceArrowDown}"
                                                      Width="12"
                                                      Height="12"
                                                      Stretch="Uniform"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="AddButton"
                                    Grid.Column="0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenPickerCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource McePlus}"
                                          Width="12"
                                          Height="12"
                                          Margin="0,0,6,0"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <TextBlock Text="{x:Static res:Strings.Multi_AddConnection}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Margin="8,0,0,0"
                                    ToolTip="{x:Static res:Strings.Multi_Remove_Tooltip}"
                                    Command="{Binding RemoveCommand}">
                                <Path Data="{StaticResource MceTrash}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Margin="4,0,0,0"
                                    ToolTip="{x:Static res:Strings.Multi_Duplicate_Tooltip}"
                                    Command="{Binding DuplicateCommand}">
                                <Path Data="{StaticResource MceCopy}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Button>

                            <!-- Inline connection picker -->
                            <Popup x:Name="PickerPopup"
                                   Grid.Column="0"
                                   Width="340"
                                   AllowsTransparency="True"
                                   Placement="Top"
                                   PlacementTarget="{Binding ElementName=AddButton}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
                                   Opened="OnPickerOpened">
                                <Border Margin="0,0,0,6"
                                        Padding="10"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrushStrong}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMedium}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Data="{StaticResource MceSearch}"
                                                  Width="13"
                                                  Height="13"
                                                  Margin="2,0,8,0"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <TextBox x:Name="PickerSearchBox"
                                                     Grid.Column="1"
                                                     Style="{StaticResource AppTextBoxStyle}"
                                                     Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Style="{StaticResource MceHint}"
                                                   Margin="0,8,0,0"
                                                   Text="{Binding PickerEmptyText}"
                                                   Visibility="{Binding PickerEmptyText, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                                        <ListBox x:Name="PickerList"
                                                 Grid.Row="2"
                                                 Margin="0,8,0,0"
                                                 MaxHeight="260"
                                                 Style="{StaticResource AppListBoxStyle}"
                                                 ItemsSource="{Binding PickerResults}"
                                                 SelectedItem="{Binding PickerSelection, Mode=TwoWay}"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                 MouseDoubleClick="OnPickerItemDoubleClick">
                                            <ListBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddSelectedCommand}" />
                                            </ListBox.InputBindings>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Margin="0,2,8,2"
                                                                Style="{StaticResource MceColourStripe}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding HostAndGroup, Mode=OneWay}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Grid.Row="3"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,10,0,0">
                                            <Button Style="{StaticResource SubtleButtonStyle}"
                                                    Content="{x:Static res:Strings.Common_Close}"
                                                    MinWidth="70"
                                                    Command="{Binding ClosePickerCommand}" />
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="{x:Static res:Strings.Multi_Picker_Add}"
                                                    MinWidth="70"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding AddSelectedCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== RIGHT: the selected item -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <TextBlock Style="{StaticResource MceHint}"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Text="{x:Static res:Strings.Multi_NoSelection_Hint}"
                               Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                    <ScrollViewer x:Name="PropertiesScroller"
                                  Style="{StaticResource AppScrollViewerStyle}"
                                  Padding="18,14,14,16"
                                  Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <!-- One panel per item, only the selected one shown: see IsSelected. -->
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Visibility="{Binding IsSelected, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">

                                        <!-- Which item this is -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0"
                                                    VerticalAlignment="Center" Style="{StaticResource MceNumberBadge}">
                                                <TextBlock Text="{Binding Position}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding ColorHex, Converter={x:Static conv:ContrastForegroundConverter.Instance}, FallbackValue=White}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Host}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{x:Static res:Strings.Multi_ResetOverrides_Tooltip}"
                                                    IsEnabled="{Binding HasOverrides}"
                                                    Command="{Binding DataContext.ClearOverridesCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource MceReset}"
                                                          Width="13"
                                                          Height="13"
                                                          Margin="0,0,6,0"
                                                          Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                    <TextBlock Text="{x:Static res:Strings.Multi_ResetOverrides}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- The item in the set -->
                                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Multi_ItemOnly_Header}" />

                                        <HeaderedContentControl Style="{StaticResource FormRowStyle}" Header="{x:Static res:Strings.Multi_DisplayName_Label}">
                                            <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                     MaxLength="80"
                                                     ToolTip="{x:Static res:Strings.Multi_DisplayName_Tooltip}"
                                                     Text="{Binding DisplayNameText, UpdateSourceTrigger=PropertyChanged}" />
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Style="{StaticResource FormRowStyle}" Header="{x:Static res:Strings.Multi_CredentialSet_Label}">
                                            <ComboBox Style="{StaticResource AppComboBoxStyle}"
                                                      ItemsSource="{Binding DataContext.CredentialOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      IsSynchronizedWithCurrentItem="False"
                                                      SelectedValue="{Binding CredentialSelection}" />
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Style="{StaticResource FormRowStyle}" Header="{x:Static res:Strings.Multi_AutoReconnect_Label}">
                                            <ComboBox Style="{StaticResource AppComboBoxStyle}"
                                                      ItemsSource="{Binding AutoReconnectOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      IsSynchronizedWithCurrentItem="False"
                                                      SelectedValue="{Binding AutoReconnectChoice}" />
                                        </HeaderedContentControl>

                                        <HeaderedContentControl Style="{StaticResource FormRowStyle}" Header="{x:Static res:Strings.Multi_DelayAfter_Label}">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                         Width="100"
                                                         HorizontalAlignment="Left"
                                                         ToolTip="{x:Static res:Strings.Multi_DelayAfter_Tooltip}"
                                                         Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource EditorHintStyle}" Text="{x:Static res:Strings.Multi_DelayAfter_Hint}" />
                                            </StackPanel>
                                        </HeaderedContentControl>

                                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                                  Margin="0,2,0,6"
                                                  HorizontalAlignment="Left"
                                                  IsChecked="{Binding Enabled}"
                                                  Content="{x:Static res:Strings.Multi_Item_Enabled_Tooltip}" />

                                        <Border Style="{StaticResource AppSeparatorStyle}" Margin="0,4,0,14" />

                                        <!-- Its display settings: the connection's, or its own in this set -->
                                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Multi_Display_Header}" />
                                        <StackPanel Margin="0,2,0,0">
                                            <RadioButton Style="{StaticResource EditorRadioStyle}"
                                                         Margin="0,2,0,2"
                                                         Content="{x:Static res:Strings.Multi_Display_FromConnection}"
                                                         IsChecked="{Binding UseConnectionDisplay}" />
                                            <RadioButton Style="{StaticResource EditorRadioStyle}"
                                                         Margin="0,2,0,2"
                                                         Content="{x:Static res:Strings.Multi_Display_Own}"
                                                         IsChecked="{Binding UseOwnDisplay}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource EditorHintStyle}"
                                                   Margin="0,4,0,6"
                                                   Text="{x:Static res:Strings.Multi_Display_Hint}" />

                                        <views:DisplaySettingsView DataContext="{Binding Display}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ BOTTOM -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasError, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Path Data="{StaticResource MceAlert}"
                              Width="14"
                              Height="14"
                              Margin="0,0,7,0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Stroke="{DynamicResource DangerBrush}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="{Binding ErrorText}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasWarning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Path Data="{StaticResource MceAlert}"
                              Width="14"
                              Height="14"
                              Margin="0,0,7,0"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Stroke="{DynamicResource WarningBrush}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="{Binding WarningText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding InfoText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding InfoText, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            MinWidth="112"
                            ToolTip="{x:Static res:Strings.Multi_LaunchNow_Tooltip}"
                            Command="{Binding LaunchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource McePlay}"
                                  Width="11"
                                  Height="11"
                                  Margin="0,0,7,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="{x:Static res:Strings.Multi_LaunchNow}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Content="{x:Static res:Strings.Common_Save}"
                            Command="{Binding SaveCommand}" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{x:Static res:Strings.Common_Cancel}"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
