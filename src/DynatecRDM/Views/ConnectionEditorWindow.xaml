                                <UniformGrid Columns="2">
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding NetworkAutoDetect, Mode=TwoWay}"
                                              IsEnabled="{Binding NetworkAutoDetectEnabled}"
                                              Content="Detect network quality automatically" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding BandwidthAutoDetect, Mode=TwoWay}"
                                              Content="Detect bandwidth automatically" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding Compression, Mode=TwoWay}"
                                              Content="Compress the session stream" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding PersistentBitmapCache, Mode=TwoWay}"
                                              Content="Persistent bitmap cache" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding MstscAutoReconnection, Mode=TwoWay}"
                                              Content="Let mstsc reconnect on its own" />
                                </UniformGrid>

                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="Network detection only applies while the connection quality is set to detect automatically." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="VISUALS" Style="{StaticResource SectionHeaderStyle}" />
                                <UniformGrid Columns="2">
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding FontSmoothing, Mode=TwoWay}"
                                              Content="Font smoothing" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding DesktopComposition, Mode=TwoWay}"
                                              Content="Desktop composition" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding ShowWallpaper, Mode=TwoWay}"
                                              Content="Desktop wallpaper" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding FullWindowDrag, Mode=TwoWay}"
                                              Content="Show window contents while dragging" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding MenuAnimations, Mode=TwoWay}"
                                              Content="Menu and window animations" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding VisualStyles, Mode=TwoWay}"
                                              Content="Visual styles" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding CursorShadow, Mode=TwoWay}"
                                              Content="Cursor shadow" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="AUDIO AND VIDEO" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Audio playback" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AudioPlaybackOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding AudioPlayback, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Audio recording" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AudioCaptureOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding AudioCapture, Mode=TwoWay}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Video playback" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding VideoPlaybackOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding VideoPlayback, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 4. LOCAL RESOURCES
                 ============================================================ -->
            <TabItem Header="Local resources">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="REDIRECTION" Style="{StaticResource SectionHeaderStyle}" />
