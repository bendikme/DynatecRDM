                                <TextBlock Text="KEYBOARD" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Apply shortcut keys" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding KeyboardHookOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding KeyboardHook, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="Decides where combinations such as Alt+Tab and the Windows key are handled." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 5. GATEWAY
                 ============================================================ -->
            <TabItem Header="Gateway">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="REMOTE DESKTOP GATEWAY" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Usage method" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding GatewayUsageOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding GatewayUsage, Mode=TwoWay}" />
                                </Grid>

                                <StackPanel IsEnabled="{Binding GatewayEnabled}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Gateway host" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding GatewayHost, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="255" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Credential source" Style="{StaticResource EditorLabelStyle}" />
                                        <ComboBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource AppComboBoxStyle}"
                                                  ItemsSource="{Binding GatewayCredentialSourceOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  SelectedValue="{Binding GatewayCredentials, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Gateway credential" Style="{StaticResource EditorLabelStyle}" />
                                        <ComboBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource AppComboBoxStyle}"
                                                  ItemsSource="{Binding GatewayCredentialOptions}"
                                                  DisplayMemberPath="Label"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  SelectedItem="{Binding SelectedGatewayCredential, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource AppToggleStyle}"
                                                  IsChecked="{Binding GatewayBypassLocal, Mode=TwoWay}"
                                                  Content="Bypass the gateway for local addresses" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource EditorHintStyle}"
                                               Text="The gateway tunnels RDP over HTTPS. Leave the gateway credential empty to reuse the session login." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 6. SECURITY AND PROGRAM
                 ============================================================ -->
            <TabItem Header="Security and program">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="SECURITY" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Authentication level" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AuthLevelOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding AuthLevel, Mode=TwoWay}" />
                                </Grid>

                                <UniformGrid Columns="2">
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding EnableCredSsp, Mode=TwoWay}"
                                              Content="Enable CredSSP (network level authentication)" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding PromptForCredentialsOnce, Mode=TwoWay}"
                                              Content="Prompt for credentials only once" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding AdministrativeSession, Mode=TwoWay}"
                                              Content="Connect to the administrative session" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding PublicMode, Mode=TwoWay}"
                                              Content="Public mode (cache nothing locally)" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="STARTUP PROGRAM" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Alternate shell" Style="{StaticResource EditorLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding AlternateShell, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="500" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Working directory" Style="{StaticResource EditorLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding ShellWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="500" />
                                </Grid>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="Starts a program instead of the remote desktop. Leave both empty for a normal desktop session." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="REMOTEAPP" Style="{StaticResource SectionHeaderStyle}" />

                                <CheckBox Style="{StaticResource AppToggleStyle}"
                                          Margin="0,0,0,10"
                                          IsChecked="{Binding RemoteAppMode, Mode=TwoWay}"
                                          Content="Run as a RemoteApp instead of a full desktop" />

                                <StackPanel IsEnabled="{Binding RemoteAppMode}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Application name" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding RemoteApplicationName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="260" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Program path or alias" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding RemoteApplicationProgram, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="500" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Command line" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding RemoteApplicationCmdLine, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="500" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="CONNECTION BROKER" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Load balance info" Style="{StaticResource EditorLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding LoadBalanceInfo, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="500" />
                                </Grid>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="The routing token a connection broker expects, for example tsv://MS Terminal Services Plugin.1.Collection" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 7. WATCHDOG
                 ============================================================ -->
            <TabItem Header="Watchdog">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="AUTOMATIC RECONNECT" Style="{StaticResource SectionHeaderStyle}" />

                                <CheckBox Style="{StaticResource AppToggleStyle}"
                                          Margin="0,0,0,12"
                                          IsChecked="{Binding AutoReconnect, Mode=TwoWay}"
                                          Content="Watch this session and bring it back if it drops" />

                                <StackPanel IsEnabled="{Binding AutoReconnect}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Maximum attempts" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 MaxLength="4"
                                                 Text="{Binding MaxReconnectAttemptsText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Text="0 means keep trying forever" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Delay between attempts" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 MaxLength="4"
                                                 Text="{Binding ReconnectDelayText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Text="seconds" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="WHAT WILL HAPPEN" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Style="{StaticResource EditorValueStyle}" Text="{Binding WatchdogSummary}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 8. ADVANCED
                 ============================================================ -->
            <TabItem Header="Advanced">
                <Grid Margin="0,0,10,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RAW .RDP PROPERTIES" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Style="{StaticResource EditorHintStyle}"
                                       Margin="0,0,0,10"
                                       Text="These lines are written verbatim into the generated .rdp file and override every setting above. Give the bare property name, for example kdcproxyname, or add the type suffix yourself, for example kdcproxyname:s." />

                            <ListBox Style="{StaticResource AppListBoxStyle}"
                                     ItemsSource="{Binding CustomProperties}"
                                     IsSynchronizedWithCurrentItem="False"
                                     MinHeight="46"
                                     MaxHeight="168"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource AppComboBoxStyle}"
                                                      IsEditable="True"
                                                      IsSynchronizedWithCurrentItem="False"
                                                      ItemsSource="{Binding DataContext.KnownPropertyNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     Style="{StaticResource AppTextBoxStyle}"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.RemoveCustomPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource AppToolTipStyle}" Content="Remove this property" />
                                                </Button.ToolTip>
                                                <Path Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      Data="{StaticResource IconClose}"
                                                      Stroke="{StaticResource TextSecondaryBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    MinWidth="132"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddCustomPropertyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource IconPlus}"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <TextBlock Text="Add property" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="GENERATED .RDP FILE" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Margin="0,0,0,10"
                                           Text="Live preview, refreshed shortly after every change. The encrypted password is never shown here." />
                            </StackPanel>
                            <TextBox Grid.Row="1"
                                     Style="{StaticResource RdpPreviewBoxStyle}"
                                     MinHeight="150"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding RdpPreview, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ================================================================
             Validation summary
             ================================================================ -->

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,10"
                Margin="0,10,0,0"
                SnapsToDevicePixels="True"
                Visibility="{Binding HasValidationSummary, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <Path Width="18"
                      Height="18"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Data="{StaticResource IconWarning}"
                      Stroke="{StaticResource DangerBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}"
                           Text="{Binding ValidationSummary}" />
            </StackPanel>
        </Border>

        <!-- ================================================================
             Footer
             ================================================================ -->

        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="18,12"
                SnapsToDevicePixels="True">
            <Grid>
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Text="Ctrl+S saves, Esc cancels." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Save"
                            IsDefault="True"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
