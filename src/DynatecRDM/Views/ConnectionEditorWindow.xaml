                                           Text="Use * for every drive, or a semicolon-separated list such as C:;D:" />

                                <Grid Margin="0,14,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppToggleStyle}"
                                              IsChecked="{Binding RedirectCameras, Mode=TwoWay}"
                                              Content="Redirect cameras" />
                                    <TextBox Grid.Column="2"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             IsEnabled="{Binding RedirectCameras}"
                                             Text="{Binding CameraList, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="200" />
