<Window x:Class="DynatecRDM.Views.ConnectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        xmlns:res="clr-namespace:DynatecRDM.Resources"
        xmlns:views="clr-namespace:DynatecRDM.Views"
        Style="{StaticResource AppWindowStyle}"
        Title="{Binding WindowTitle}"
        Width="1060"
        Height="800"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- ============================================================
             Icons. Drawn as geometry so nothing depends on an icon font
             being installed. All are authored inside a 24x24 box.
             ============================================================ -->

        <PathGeometry x:Key="IconPulse" Figures="M2,12 L7,12 L9.5,6 L14,18 L16.5,12 L22,12" />
        <PathGeometry x:Key="IconCard" Figures="M3,6 H21 V18 H3 Z M6,10 H10 M6,13.5 H9 M14,10 H18 M14,13.5 H18" />
        <PathGeometry x:Key="IconPlus" Figures="M12,5 V19 M5,12 H19" />
        <PathGeometry x:Key="IconClose" Figures="M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5" />
        <PathGeometry x:Key="IconWarning" Figures="M12,4 L21.5,19.5 L2.5,19.5 Z M12,10 V14 M12,16.4 V17.6" />

        <!-- ============================================================
             Read-only monospace preview. Same shell as AppTextBoxStyle,
             but the scroll bars follow the control instead of being
             pinned to Hidden, which the preview needs.
             ============================================================ -->

        <Style x:Key="RdpPreviewBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================
             Header
             ================================================================ -->

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="18,14"
                SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="{StaticResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding HeaderSubtitle}"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ================================================================
             Tabs
             ================================================================ -->

        <TabControl Grid.Row="1"
                    Margin="18,8,18,0"
                    Style="{StaticResource AppTabControlStyle}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ============================================================
                 1. GENERAL
                 ============================================================ -->
            <TabItem Header="{x:Static res:Strings.Editor_Tab_General}">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Identity_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_Name}" Style="{StaticResource EditorLabelStyle}" VerticalAlignment="Top" Margin="0,7,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="120" />
                                        <TextBlock Style="{StaticResource EditorErrorStyle}"
                                                   Text="{Binding NameError}"
                                                   Visibility="{Binding NameError, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_Description}" Style="{StaticResource EditorLabelStyle}" VerticalAlignment="Top" Margin="0,7,12,0" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="400" />
                                </Grid>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_Host}" Style="{StaticResource EditorLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="255" />
                                    <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Editor_Port}" Style="{StaticResource EditorLabelStyle}" Margin="0,0,10,0" />
                                    <TextBox Grid.Column="4"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="5" />
                                    <Button Grid.Column="6"
                                            VerticalAlignment="Center"
                                            MinWidth="96"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding TestCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="18"
                                                  Height="18"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Data="{StaticResource IconPulse}"
                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                            <TextBlock Text="{x:Static res:Strings.Editor_Test}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource EditorErrorStyle}"
                                                   Text="{Binding HostError}"
                                                   Visibility="{Binding HostError, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                                        <TextBlock Style="{StaticResource EditorErrorStyle}"
                                                   Text="{Binding PortError}"
                                                   Visibility="{Binding PortError, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                                        <TextBlock Text="{Binding TestResultText}"
                                                   Visibility="{Binding TestResultText, Converter={x:Static conv:StringToVisibilityConverter.Instance}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource EditorHintStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TestSucceeded}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Organisation_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_Group}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding Groups}"
                                              DisplayMemberPath="Label"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_CredentialSet}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding Credentials}"
                                              DisplayMemberPath="Label"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedItem="{Binding SelectedCredential, Mode=TwoWay}" />
                                    <Button Grid.Column="3"
                                            VerticalAlignment="Center"
                                            MinWidth="116"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ManageCredentialsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="18"
                                                  Height="18"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Data="{StaticResource IconCard}"
                                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                            <TextBlock Text="{x:Static res:Strings.Editor_ManageCredentials}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Style="{StaticResource EditorHintStyle}" Text="{Binding CredentialSummary}" Margin="0,0,0,0" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_CredentialDelivery}" Style="{StaticResource EditorLabelStyle}" VerticalAlignment="Top" Margin="0,7,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <ComboBox Style="{StaticResource AppComboBoxStyle}"
                                                  ItemsSource="{Binding CredentialDeliveryOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  SelectedValue="{Binding CredentialDeliveryMode, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource EditorHintStyle}" Text="{Binding CredentialDeliveryHelp}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Appearance_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_Colour}" Style="{StaticResource EditorLabelStyle}" VerticalAlignment="Top" Margin="0,7,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <ListBox Style="{StaticResource AppListBoxStyle}"
                                                 ItemsSource="{Binding ColorOptions}"
                                                 SelectedItem="{Binding SelectedColorOption, Mode=TwoWay}"
                                                 IsSynchronizedWithCurrentItem="False"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="18" Height="18">
                                                        <Border CornerRadius="9"
                                                                Background="{Binding Hex, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                                                BorderThickness="1"
                                                                SnapsToDevicePixels="True" />
                                                        <Path Data="M3.5,14.5 L14.5,3.5"
                                                              Stroke="{DynamicResource TextMutedBrush}"
                                                              StrokeThickness="1.4"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Visibility="{Binding IsNone, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Style="{StaticResource EditorHintStyle}" Text="{Binding SelectedColorOption.Name}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_Tags}" Style="{StaticResource EditorLabelStyle}" VerticalAlignment="Top" Margin="0,7,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="200" />
                                        <TextBlock Style="{StaticResource EditorHintStyle}" Text="{x:Static res:Strings.Editor_Tags_Hint}" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource AppToggleStyle}"
                                              IsChecked="{Binding Favorite, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Favourite}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 2. DISPLAY
                 Full screen or a window first, then where - so no two
                 choices on this tab can contradict each other.
                 ============================================================ -->
            <TabItem Header="{x:Static res:Strings.Editor_Tab_Display}">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <views:DisplaySettingsView DataContext="{Binding Display}" Margin="0,0,0,2">
                        <views:DisplaySettingsView.Map>
                            <views:MonitorMapView Height="230" />
                        </views:DisplaySettingsView.Map>
                    </views:DisplaySettingsView>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 3. EXPERIENCE
                 ============================================================ -->
            <TabItem Header="{x:Static res:Strings.Editor_Tab_Experience}">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Presets_Header}" Style="{StaticResource SectionHeaderStyle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinWidth="130"
                                            Content="LAN" Command="{Binding LanPresetCommand}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinWidth="130"
                                            Content="{x:Static res:Strings.Editor_Preset_Balanced}" Command="{Binding BalancedPresetCommand}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" MinWidth="130"
                                            Content="{x:Static res:Strings.Editor_Preset_LowBandwidth}" Command="{Binding LowBandwidthPresetCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="{x:Static res:Strings.Editor_Presets_Hint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Connection_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_ConnectionQuality}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding QualityOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding Quality, Mode=TwoWay}" />
                                </Grid>

                                <UniformGrid Columns="2">
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding NetworkAutoDetect, Mode=TwoWay}"
                                              IsEnabled="{Binding NetworkAutoDetectEnabled}"
                                              Content="{x:Static res:Strings.Editor_NetworkAutoDetect}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding BandwidthAutoDetect, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_BandwidthAutoDetect}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding Compression, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Compression}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding PersistentBitmapCache, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_BitmapCache}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding MstscAutoReconnection, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_MstscAutoReconnect}" />
                                </UniformGrid>

                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="{x:Static res:Strings.Editor_NetworkDetect_Hint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Visuals_Header}" Style="{StaticResource SectionHeaderStyle}" />
                                <UniformGrid Columns="2">
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding FontSmoothing, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_FontSmoothing}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding DesktopComposition, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_DesktopComposition}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding ShowWallpaper, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Wallpaper}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding FullWindowDrag, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_FullWindowDrag}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding MenuAnimations, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_MenuAnimations}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding VisualStyles, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_VisualStyles}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding CursorShadow, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_CursorShadow}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_AudioVideo_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_AudioPlayback}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AudioPlaybackOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding AudioPlayback, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_AudioRecording}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AudioCaptureOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding AudioCapture, Mode=TwoWay}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_VideoPlayback}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding VideoPlaybackOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding VideoPlayback, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 4. LOCAL RESOURCES
                 ============================================================ -->
            <TabItem Header="{x:Static res:Strings.Editor_Tab_LocalResources}">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Redirection_Header}" Style="{StaticResource SectionHeaderStyle}" />
                                <UniformGrid Columns="2">
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding RedirectClipboard, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Redirect_Clipboard}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding RedirectPrinters, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Redirect_Printers}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding RedirectSmartCards, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Redirect_SmartCards}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding RedirectPorts, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Redirect_Ports}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding RedirectPnpDevices, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Redirect_PnpDevices}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding RedirectWebAuthn, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Redirect_WebAuthn}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding RedirectLocation, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_Redirect_Location}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_DrivesCameras_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppToggleStyle}"
                                              IsChecked="{Binding RedirectDrives, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_RedirectDrives}" />
                                    <TextBox Grid.Column="2"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             IsEnabled="{Binding RedirectDrives}"
                                             Text="{Binding DriveList, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="200" />
                                </Grid>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="{x:Static res:Strings.Editor_Drives_Hint}" />

                                <Grid Margin="0,14,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppToggleStyle}"
                                              IsChecked="{Binding RedirectCameras, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_RedirectCameras}" />
                                    <TextBox Grid.Column="2"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             IsEnabled="{Binding RedirectCameras}"
                                             Text="{Binding CameraList, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="200" />
                                </Grid>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="{x:Static res:Strings.Editor_Cameras_Hint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Keyboard_Header}" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_KeyboardHook}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding KeyboardHookOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding KeyboardHook, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="{x:Static res:Strings.Editor_KeyboardHook_Hint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 5. GATEWAY
                 ============================================================ -->
            <TabItem Header="{x:Static res:Strings.Editor_Tab_Gateway}">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Gateway_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_GatewayUsage}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding GatewayUsageOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding GatewayUsage, Mode=TwoWay}" />
                                </Grid>

                                <StackPanel IsEnabled="{Binding GatewayEnabled}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_GatewayHost}" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding GatewayHost, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="255" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_GatewayCredentialSource}" Style="{StaticResource EditorLabelStyle}" />
                                        <ComboBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource AppComboBoxStyle}"
                                                  ItemsSource="{Binding GatewayCredentialSourceOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  SelectedValue="{Binding GatewayCredentials, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_GatewayCredential}" Style="{StaticResource EditorLabelStyle}" />
                                        <ComboBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource AppComboBoxStyle}"
                                                  ItemsSource="{Binding GatewayCredentialOptions}"
                                                  DisplayMemberPath="Label"
                                                  IsSynchronizedWithCurrentItem="False"
                                                  SelectedItem="{Binding SelectedGatewayCredential, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource AppToggleStyle}"
                                                  IsChecked="{Binding GatewayBypassLocal, Mode=TwoWay}"
                                                  Content="{x:Static res:Strings.Editor_GatewayBypassLocal}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource EditorHintStyle}"
                                               Text="{x:Static res:Strings.Editor_Gateway_Hint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 6. SECURITY AND PROGRAM
                 ============================================================ -->
            <TabItem Header="{x:Static res:Strings.Editor_Tab_SecurityProgram}">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Security_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_AuthLevel}" Style="{StaticResource EditorLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              ItemsSource="{Binding AuthLevelOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              IsSynchronizedWithCurrentItem="False"
                                              SelectedValue="{Binding AuthLevel, Mode=TwoWay}" />
                                </Grid>

                                <UniformGrid Columns="2">
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding EnableCredSsp, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_EnableCredSsp}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding PromptForCredentialsOnce, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_PromptCredentialsOnce}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding AdministrativeSession, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_AdminSession}" />
                                    <CheckBox Style="{StaticResource AppToggleStyle}" Margin="0,6,12,6"
                                              IsChecked="{Binding PublicMode, Mode=TwoWay}"
                                              Content="{x:Static res:Strings.Editor_PublicMode}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_StartupProgram_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_AlternateShell}" Style="{StaticResource EditorLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding AlternateShell, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="500" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_WorkingDirectory}" Style="{StaticResource EditorLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding ShellWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="500" />
                                </Grid>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="{x:Static res:Strings.Editor_StartupProgram_Hint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="REMOTEAPP" Style="{StaticResource SectionHeaderStyle}" />

                                <CheckBox Style="{StaticResource AppToggleStyle}"
                                          Margin="0,0,0,10"
                                          IsChecked="{Binding RemoteAppMode, Mode=TwoWay}"
                                          Content="{x:Static res:Strings.Editor_RemoteAppMode}" />

                                <StackPanel IsEnabled="{Binding RemoteAppMode}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_RemoteAppName}" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding RemoteApplicationName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="260" />
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_RemoteAppProgram}" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding RemoteApplicationProgram, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="500" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_RemoteAppCmdLine}" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding RemoteApplicationCmdLine, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="500" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_Broker_Header}" Style="{StaticResource SectionHeaderStyle}" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_LoadBalanceInfo}" Style="{StaticResource EditorLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Text="{Binding LoadBalanceInfo, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="500" />
                                </Grid>
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Text="{x:Static res:Strings.Editor_LoadBalanceInfo_Hint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 7. WATCHDOG
                 ============================================================ -->
            <TabItem Header="{x:Static res:Strings.Editor_Tab_Watchdog}">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                    <StackPanel Margin="0,0,0,14">

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_AutoReconnect_Header}" Style="{StaticResource SectionHeaderStyle}" />

                                <CheckBox Style="{StaticResource AppToggleStyle}"
                                          Margin="0,0,0,12"
                                          IsChecked="{Binding AutoReconnect, Mode=TwoWay}"
                                          Content="{x:Static res:Strings.Editor_AutoReconnect}" />

                                <StackPanel IsEnabled="{Binding AutoReconnect}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_MaxAttempts}" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 MaxLength="4"
                                                 Text="{Binding MaxReconnectAttemptsText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Text="{x:Static res:Strings.Editor_MaxAttempts_Hint}" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Editor_ReconnectDelay}" Style="{StaticResource EditorLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Style="{StaticResource AppTextBoxStyle}"
                                                 MaxLength="4"
                                                 Text="{Binding ReconnectDelayText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Text="{x:Static res:Strings.Editor_Seconds}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.Editor_WhatWillHappen_Header}" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Style="{StaticResource EditorValueStyle}" Text="{Binding WatchdogSummary}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 8. ADVANCED
                 ============================================================ -->
            <TabItem Header="{x:Static res:Strings.Editor_Tab_Advanced}">
                <Grid Margin="0,0,10,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Editor_RawProperties_Header}" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Style="{StaticResource EditorHintStyle}"
                                       Margin="0,0,0,10"
                                       Text="{x:Static res:Strings.Editor_RawProperties_Hint}" />

                            <ListBox Style="{StaticResource AppListBoxStyle}"
                                     ItemsSource="{Binding CustomProperties}"
                                     IsSynchronizedWithCurrentItem="False"
                                     MinHeight="46"
                                     MaxHeight="168"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource AppComboBoxStyle}"
                                                      IsEditable="True"
                                                      IsSynchronizedWithCurrentItem="False"
                                                      ItemsSource="{Binding DataContext.KnownPropertyNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     Style="{StaticResource AppTextBoxStyle}"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding DataContext.RemoveCustomPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource AppToolTipStyle}" Content="{x:Static res:Strings.Editor_RemoveProperty_Tooltip}" />
                                                </Button.ToolTip>
                                                <Path Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      Data="{StaticResource IconClose}"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    MinWidth="132"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddCustomPropertyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16"
                                          Height="16"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource IconPlus}"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <TextBlock Text="{x:Static res:Strings.Editor_AddProperty}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{x:Static res:Strings.Editor_Generated_Header}" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Style="{StaticResource EditorHintStyle}"
                                           Margin="0,0,0,10"
                                           Text="{x:Static res:Strings.Editor_Generated_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Row="1"
                                     Style="{StaticResource RdpPreviewBoxStyle}"
                                     MinHeight="150"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding RdpPreview, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ================================================================
             Validation summary
             ================================================================ -->

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,10"
                Margin="0,10,0,0"
                SnapsToDevicePixels="True"
                Visibility="{Binding HasValidationSummary, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <Path Width="18"
                      Height="18"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Data="{StaticResource IconWarning}"
                      Stroke="{DynamicResource DangerBrush}"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding ValidationSummary}" />
            </StackPanel>
        </Border>

        <!-- ================================================================
             Footer
             ================================================================ -->

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="18,12"
                SnapsToDevicePixels="True">
            <Grid>
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Text="{x:Static res:Strings.Editor_Footer_Hint}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{x:Static res:Strings.Common_Cancel}"
                            Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{x:Static res:Strings.Common_Save}"
                            IsDefault="True"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
