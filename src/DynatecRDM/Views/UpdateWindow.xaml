<Window x:Class="DynatecRDM.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        xmlns:views="clr-namespace:DynatecRDM.Views"
        xmlns:res="clr-namespace:DynatecRDM.Resources"
        Style="{StaticResource AppWindowStyle}"
        Title="{x:Static res:Strings.Update_Title}"
        Width="560"
        Height="480"
        MinWidth="520"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- Icons: 24x24 path geometries, local to this file. -->
        <PathGeometry x:Key="UpdIconCheck" Figures="M 3.5,12.5 L 9.5,18.5 L 20.5,6" />
        <PathGeometry x:Key="UpdIconAlert" Figures="M 12,3.6 L 22.2,20.4 L 1.8,20.4 Z M 12,9.6 L 12,14.8 M 12,17.5 L 12,17.6" />
        <PathGeometry x:Key="UpdIconInfo" Figures="M 12,2.9 A 9.1,9.1 0 1 1 11.9,2.9 M 12,11 L 12,17 M 12,7.3 L 12,7.4" />
        <PathGeometry x:Key="UpdIconPackage" Figures="M 12,3 L 20.5,7.5 L 20.5,16.5 L 12,21 L 3.5,16.5 L 3.5,7.5 Z M 3.5,7.5 L 12,12 L 20.5,7.5 M 12,12 L 12,21" />
        <PathGeometry x:Key="UpdIconDownload" Figures="M 12,3 L 12,15 M 6.5,9.5 L 12,15 L 17.5,9.5 M 4,20.5 L 20,20.5" />

        <Style x:Key="UpdHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="UpdBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style x:Key="UpdHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The stock progress bar template is used as-is; only its colours are themed. -->
        <Style x:Key="UpdProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="UpdStateIconStyle" TargetType="Path">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================ header -->

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static res:Strings.Update_Title}"
                           FontSize="{StaticResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource UpdBodyStyle}"
                           Text="{Binding CurrentVersionText}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Style="{StaticResource StatusPillStyle}"
                    VerticalAlignment="Top"
                    Margin="12,2,0,0"
                    Visibility="{Binding IsPrerelease, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="{x:Static res:Strings.Update_Prerelease_Pill}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource WarningBrush}" />
            </Border>
        </Grid>

        <!-- ================================================================ states -->

        <Grid Grid.Row="1" Margin="0,18,0,0">

            <!-- Checking -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding IsChecking, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <TextBlock Style="{StaticResource UpdHeadingStyle}"
                           HorizontalAlignment="Center"
                           Text="{x:Static res:Strings.Update_Checking}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource UpdBodyStyle}"
                           HorizontalAlignment="Center"
                           Text="{Binding RepositoryText}" />
                <ProgressBar Style="{StaticResource UpdProgressStyle}"
                             Width="280"
                             Margin="0,20,0,0"
                             IsIndeterminate="True" />
            </StackPanel>

            <!-- Up to date -->
            <StackPanel VerticalAlignment="Center"
                        MaxWidth="420"
                        Visibility="{Binding IsUpToDate, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Path Style="{StaticResource UpdStateIconStyle}"
                      Data="{StaticResource UpdIconCheck}"
                      Stroke="{DynamicResource SuccessBrush}" />
                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource UpdHeadingStyle}"
                           TextAlignment="Center"
                           Text="{Binding UpToDateText}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource UpdBodyStyle}"
                           TextAlignment="Center"
                           Text="{Binding StatusDetail}"
                           Visibility="{Binding StatusDetail, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource UpdHintStyle}"
                           TextAlignment="Center"
                           Text="{Binding LastCheckedText}" />
                <TextBlock Margin="0,2,0,0"
                           Style="{StaticResource UpdHintStyle}"
                           TextAlignment="Center"
                           Text="{Binding RepositoryText}" />
            </StackPanel>

            <!-- Not configured -->
            <StackPanel VerticalAlignment="Center"
                        MaxWidth="400"
                        Visibility="{Binding NotConfigured, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Path Style="{StaticResource UpdStateIconStyle}"
                      Data="{StaticResource UpdIconInfo}"
                      Stroke="{DynamicResource AccentBrush}" />
                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource UpdHeadingStyle}"
                           TextAlignment="Center"
                           Text="{x:Static res:Strings.Update_NotConfigured_Header}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource UpdBodyStyle}"
                           TextAlignment="Center"
                           Text="{Binding NotConfiguredText}" />
            </StackPanel>

            <!-- Update available -->
            <Grid Visibility="{Binding HasUpdate, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource UpdHeadingStyle}"
                           Text="{Binding AvailableVersionText}" />

                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Style="{StaticResource UpdBodyStyle}"
                           Text="{Binding VersionComparisonText}" />

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Style="{StaticResource CardBorderStyle}"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Padding="2">
                    <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" Padding="10,8,12,8">
                        <TextBlock Text="{Binding ReleaseNotes}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   LineHeight="17"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="0,12,0,0"
                            Visibility="{Binding Update.Assets, Converter={x:Static conv:CountToVisibilityConverter.Instance}}">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Update_Download_Header}" />
                    <ItemsControl ItemsSource="{Binding Update.Assets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Width="13" Height="13"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Data="{StaticResource UpdIconPackage}"
                                          Stroke="{DynamicResource TextMutedBrush}"
                                          StrokeThickness="1.5"
                                          StrokeLineJoin="Round" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"
                                               Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding Size, Converter={x:Static views:ByteSizeConverter.Instance}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Downloading -->
            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding IsDownloading, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Path Style="{StaticResource UpdStateIconStyle}"
                      Data="{StaticResource UpdIconDownload}"
                      Stroke="{DynamicResource AccentBrush}" />
                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource UpdHeadingStyle}"
                           TextAlignment="Center"
                           Text="{Binding AvailableVersionText}" />
                <ProgressBar Style="{StaticResource UpdProgressStyle}"
                             Width="320"
                             Margin="0,16,0,0"
                             Value="{Binding DownloadProgress, Mode=OneWay}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource UpdBodyStyle}"
                           TextAlignment="Center"
                           Text="{Binding ProgressText}" />
            </StackPanel>

            <!-- Ready to install -->
            <StackPanel VerticalAlignment="Center"
                        MaxWidth="420"
                        Visibility="{Binding IsReadyToInstall, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Path Style="{StaticResource UpdStateIconStyle}"
                      Data="{StaticResource UpdIconCheck}"
                      Stroke="{DynamicResource SuccessBrush}" />
                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource UpdHeadingStyle}"
                           TextAlignment="Center"
                           Text="{Binding ReadyToInstallText}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource UpdBodyStyle}"
                           TextAlignment="Center"
                           Text="{x:Static res:Strings.Update_Ready_Restart}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource UpdHintStyle}"
                           TextAlignment="Center"
                           Text="{x:Static res:Strings.Update_Ready_DataSafe}" />
            </StackPanel>

            <!-- Failed -->
            <StackPanel VerticalAlignment="Center"
                        MaxWidth="420"
                        Visibility="{Binding HasFailed, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <Path Style="{StaticResource UpdStateIconStyle}"
                      Data="{StaticResource UpdIconAlert}"
                      Stroke="{DynamicResource DangerBrush}" />
                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource UpdHeadingStyle}"
                           TextAlignment="Center"
                           Text="{x:Static res:Strings.Update_Failed_Header}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource UpdBodyStyle}"
                           TextAlignment="Center"
                           Text="{Binding Message}" />
            </StackPanel>
        </Grid>

        <!-- ================================================================ footer -->

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SubtleButtonStyle}"
                        Padding="0,6"
                        MinWidth="0"
                        Foreground="{DynamicResource AccentBrush}"
                        Content="{x:Static res:Strings.Update_ViewOnGitHub}"
                        Command="{Binding OpenReleasePageCommand}"
                        Visibility="{Binding ShowReleaseLink, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource UpdHintStyle}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Text="{Binding Notice}"
                           Visibility="{Binding Notice, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="12,0,0,0">

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsChecking, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Button Content="{x:Static res:Strings.Common_Close}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CloseCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsUpToDate, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Button Content="{x:Static res:Strings.Common_Close}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CloseCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="{x:Static res:Strings.Update_CheckAgain}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckCommand}"
                            IsDefault="True" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding NotConfigured, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Button Content="{x:Static res:Strings.Common_Close}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CloseCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="{x:Static res:Strings.Update_OpenSettings}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenSettingsCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasUpdate, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Button Content="{x:Static res:Strings.Update_Skip}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding SkipCommand}"
                            ToolTip="{x:Static res:Strings.Update_Skip_Tooltip}" />
                    <Button Margin="8,0,0,0"
                            Content="{x:Static res:Strings.Update_Later}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CloseCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="{x:Static res:Strings.Update_DownloadAndInstall}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding DownloadCommand}"
                            IsDefault="True" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsDownloading, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Button Content="{x:Static res:Strings.Common_Cancel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelDownloadCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsReadyToInstall, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Button Content="{x:Static res:Strings.Update_Later}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CloseCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="{x:Static res:Strings.Update_InstallNow}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding InstallCommand}"
                            IsDefault="True" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasFailed, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Button Content="{x:Static res:Strings.Common_Close}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CloseCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="{x:Static res:Strings.Update_TryAgain}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckCommand}"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
