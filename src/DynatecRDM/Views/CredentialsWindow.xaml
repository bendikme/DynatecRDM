<Window x:Class="DynatecRDM.Views.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        Style="{StaticResource AppWindowStyle}"
        Title="Credential manager"
        Width="1060"
        Height="820"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshVaultCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- Icons: 24x24 path geometries, local to this file. -->
        <PathGeometry x:Key="CredIconPlus" Figures="M 12,5 L 12,19 M 5,12 L 19,12" />
        <PathGeometry x:Key="CredIconCopy" Figures="M 9,9 L 20,9 L 20,20 L 9,20 Z M 15,9 L 15,4 L 4,4 L 4,15 L 9,15" />
        <PathGeometry x:Key="CredIconTrash" Figures="M 4,7 L 20,7 M 10,7 L 10,4 L 14,4 L 14,7 M 6.5,7 L 7.6,20 L 16.4,20 L 17.5,7 M 10.3,10.5 L 10.3,16.5 M 13.7,10.5 L 13.7,16.5" />
        <PathGeometry x:Key="CredIconRefresh" Figures="M 16.95,7.05 A 7,7 0 1 1 7.05,7.05 M 7.05,2.8 L 7.05,7.6 L 11.85,7.6" />
        <PathGeometry x:Key="CredIconLock" Figures="M 6.5,11 L 17.5,11 L 17.5,20 L 6.5,20 Z M 9,11 L 9,8 A 3,3 0 0 1 15,8 L 15,11" />
        <PathGeometry x:Key="CredIconChevronRight" Figures="M 10,6 L 16,12 L 10,18" />
        <PathGeometry x:Key="CredIconChevronDown" Figures="M 6,10 L 12,16 L 18,10" />
        <PathGeometry x:Key="CredIconArrowRight" Figures="M 4,12 L 19,12 M 13.5,6.5 L 19,12 L 13.5,17.5" />

        <Style x:Key="CredFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CredHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CredBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style x:Key="CredCodeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CredColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CredCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CredStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="230" />
            <RowDefinition Height="3*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Credential manager"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,2,0,0"
                       Style="{StaticResource CredBodyStyle}"
                       Text="Reusable logins for your connections, and the Windows credential cache they feed." />
        </StackPanel>

        <!-- ====================================================== list + editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: the stored credential sets -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Text="CREDENTIAL SETS" />

                    <ListBox x:Name="SetList"
                             Grid.Row="1"
                             Style="{StaticResource AppListBoxStyle}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding QualifiedUsername}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource StatusPillStyle}"
                                            Visibility="{Binding IsDefault, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="Default"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding NewCommand}"
                                ToolTip="Create a new credential set">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CredIconPlus}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="New" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DuplicateCommand}"
                                ToolTip="Copy the selected set, password included">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CredIconCopy}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Duplicate" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeleteCommand}"
                                ToolTip="Delete the selected set">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CredIconTrash}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Delete" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: the editor for the selected set -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource CredBodyStyle}"
                               TextAlignment="Center"
                               Text="Select a credential set on the left, or create one."
                               Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                    <Grid Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Text="EDIT CREDENTIAL SET" />

                        <ScrollViewer Grid.Row="1" Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                            <StackPanel>

                                <TextBlock Style="{StaticResource CredFieldLabelStyle}" Text="Name" />
                                <TextBox x:Name="NameBox"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource CredFieldLabelStyle}" Text="Domain" />
                                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding EditDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="120" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource CredFieldLabelStyle}" Text="User name" />
                                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="256" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,10,0,0" Style="{StaticResource CredFieldLabelStyle}" Text="Password" />

                                <!-- A password is on file and has not been touched. -->
                                <Grid Visibility="{Binding ShowStoredPasswordHint, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource StatusPillStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource CredIconLock}"
                                                  Width="11" Height="11" Stretch="Uniform"
                                                  Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Password stored"
                                                       Margin="6,0,0,0"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="1"
                                            Content="Change"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Command="{Binding ChangePasswordCommand}"
                                            ToolTip="Replace the stored password" />
                                </Grid>

                                <!-- The box is live: typing here replaces the stored password. -->
                                <Grid Visibility="{Binding ShowPasswordBox, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PasswordInput"
                                                 Grid.Column="0"
                                                 Style="{StaticResource AppPasswordBoxStyle}"
                                                 PasswordChanged="OnPasswordChanged" />
                                    <Button Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Content="Keep existing"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Command="{Binding KeepPasswordCommand}"
                                            Visibility="{Binding HasStoredPassword, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                            ToolTip="Leave the stored password untouched" />
                                </Grid>

                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource CredHintStyle}"
                                           Text="Protected with DPAPI for your Windows account. It is never shown again and never written to disk in the clear." />

                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CredFieldLabelStyle}" Text="Notes" />
                                <TextBox Style="{StaticResource AppTextBoxStyle}"
                                         Height="66"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding EditNotes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MaxLength="2000" />

                                <CheckBox Margin="0,14,0,0"
                                          Style="{StaticResource AppToggleStyle}"
                                          Content="Default for new connections"
                                          IsChecked="{Binding EditIsDefault, Mode=TwoWay}" />
                                <TextBlock Margin="48,4,0,0"
                                           Style="{StaticResource CredHintStyle}"
                                           Text="New connections pick this set automatically. Only one set can be the default." />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Revert"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding RevertCommand}"
                                    MinWidth="88" />
                            <Button Margin="8,0,0,0"
                                    Content="Save"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================================== the Windows Credential Vault -->
        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title + the explanation of what this pane touches -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CredIconLock}"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Margin="6,0,0,6"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Text="WINDOWS CREDENTIAL VAULT - TERMSRV ENTRIES" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CredBodyStyle}"
                               MaxWidth="900"
                               HorizontalAlignment="Left"
                               Text="Windows caches remote-desktop logins per host under the target name TERMSRV/&lt;host&gt;. This is the same store the cmdkey command works with. DYNATEC RDM writes it through the Windows credential API directly, which is safer than cmdkey because the password never appears on a command line." />
                </StackPanel>

                <!-- Toolbar: refresh, host, apply -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="300" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshVaultCommand}"
                            ToolTip="Re-read the vault (F5)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CredIconRefresh}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Margin="14,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Host" />

                    <TextBox Grid.Column="2"
                             Style="{StaticResource AppTextBoxStyle}"
                             Text="{Binding VaultHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="255"
                             ToolTip="The host name exactly as the connection uses it" />

                    <Button Grid.Column="3"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ApplyToHostCommand}"
                            ToolTip="Cache the selected credential set for this host">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CredIconArrowRight}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Apply to host..." Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="4"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding VaultSummary}" />
                </Grid>

                <!-- Write method -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <CheckBox Style="{StaticResource AppToggleStyle}"
                              Content="Write through cmdkey.exe instead of the Windows credential API"
                              IsChecked="{Binding UseCmdKey, Mode=TwoWay}" />
                    <TextBlock Margin="48,4,0,0"
                               Style="{StaticResource CredHintStyle}"
                               Text="{Binding WriteMethodExplanation}" />
                </StackPanel>

                <!-- Column headers, aligned with the item template below -->
                <Grid Grid.Row="3" Margin="12,12,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CredColumnHeaderStyle}" Text="HOST" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CredColumnHeaderStyle}" Text="USER NAME" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Style="{StaticResource CredColumnHeaderStyle}" Text="TYPE" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="3" Style="{StaticResource CredColumnHeaderStyle}" Text="PERSISTENCE" Margin="8,0,0,0" />
                </Grid>

                <Grid Grid.Row="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource CredHintStyle}"
                               Text="No TERMSRV entries are cached for your account."
                               Visibility="{Binding HasVaultEntries, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                    <ListBox Style="{StaticResource AppListBoxStyle}"
                             ItemsSource="{Binding VaultEntries}"
                             SelectedItem="{Binding SelectedVaultEntry, Mode=TwoWay}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             Visibility="{Binding HasVaultEntries, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Host}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding TargetName}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource CredCellStyle}"
                                               Text="{Binding Username}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource CredCellStyle}"
                                               Text="{Binding TypeName}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource CredCellStyle}"
                                               Text="{Binding PersistName}" />

                                    <Button Grid.Column="4"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            Command="{Binding DataContext.DeleteVaultEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove this cached login">
                                        <Path Data="{StaticResource CredIconTrash}"
                                              Width="13" Height="13" Stretch="Uniform"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Equivalent commands -->
                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <Button HorizontalAlignment="Left"
                            Padding="6,3"
                            MinHeight="24"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding ToggleCommandsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CredIconChevronRight}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ShowCommands, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />
                            <Path Data="{StaticResource CredIconChevronDown}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ShowCommands, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="Equivalent commands" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Margin="0,6,0,0"
                            Style="{StaticResource CardBorderStyle}"
                            Background="{StaticResource SurfaceAltBrush}"
                            Padding="10"
                            Visibility="{Binding ShowCommands, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CredCodeStyle}" Text="{Binding ListCommandText}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CredCodeStyle}" Text="{Binding DeleteCommandText}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CredCodeStyle}" Text="{Binding GenericCommandText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="Copy"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CopyCommandsCommand}"
                                    ToolTip="Copies the three lines. The password stays a placeholder." />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource CredStatusStyle}" Text="{Binding Status}" />
            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    Content="Close"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
