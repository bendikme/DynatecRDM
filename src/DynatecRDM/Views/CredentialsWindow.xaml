<Window x:Class="DynatecRDM.Views.CredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        xmlns:res="clr-namespace:DynatecRDM.Resources"
        Style="{StaticResource AppWindowStyle}"
        Title="{x:Static res:Strings.Creds_Title}"
        Width="1060"
        Height="820"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshVaultCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- Icons: 24x24 path geometries, local to this file. -->
        <PathGeometry x:Key="CredIconPlus" Figures="M 12,5 L 12,19 M 5,12 L 19,12" />
        <PathGeometry x:Key="CredIconCopy" Figures="M 9,9 L 20,9 L 20,20 L 9,20 Z M 15,9 L 15,4 L 4,4 L 4,15 L 9,15" />
        <PathGeometry x:Key="CredIconTrash" Figures="M 4,7 L 20,7 M 10,7 L 10,4 L 14,4 L 14,7 M 6.5,7 L 7.6,20 L 16.4,20 L 17.5,7 M 10.3,10.5 L 10.3,16.5 M 13.7,10.5 L 13.7,16.5" />
        <PathGeometry x:Key="CredIconRefresh" Figures="M 16.95,7.05 A 7,7 0 1 1 7.05,7.05 M 7.05,2.8 L 7.05,7.6 L 11.85,7.6" />
        <PathGeometry x:Key="CredIconLock" Figures="M 6.5,11 L 17.5,11 L 17.5,20 L 6.5,20 Z M 9,11 L 9,8 A 3,3 0 0 1 15,8 L 15,11" />
        <PathGeometry x:Key="CredIconChevronRight" Figures="M 10,6 L 16,12 L 10,18" />
        <PathGeometry x:Key="CredIconChevronDown" Figures="M 6,10 L 12,16 L 18,10" />
        <PathGeometry x:Key="CredIconArrowRight" Figures="M 4,12 L 19,12 M 13.5,6.5 L 19,12 L 13.5,17.5" />

        <Style x:Key="CredFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CredHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CredBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style x:Key="CredCodeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CredColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CredCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CredStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="230" />
            <RowDefinition Height="3*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.Creds_Title}"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Margin="0,2,0,0"
                       Style="{StaticResource CredBodyStyle}"
                       Text="{x:Static res:Strings.Creds_Intro}" />
        </StackPanel>

        <!-- ====================================================== list + editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: the stored credential sets -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Creds_Sets_Header}" />

                    <ListBox x:Name="SetList"
                             Grid.Row="1"
                             Style="{StaticResource AppListBoxStyle}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding QualifiedUsername}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource StatusPillStyle}"
                                            Visibility="{Binding IsDefault, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{x:Static res:Strings.Creds_DefaultBadge}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding NewCommand}"
                                ToolTip="{x:Static res:Strings.Creds_New_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CredIconPlus}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Strings.Creds_New}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DuplicateCommand}"
                                ToolTip="{x:Static res:Strings.Creds_Duplicate_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CredIconCopy}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Strings.Creds_Duplicate}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeleteCommand}"
                                ToolTip="{x:Static res:Strings.Creds_Delete_Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CredIconTrash}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Strings.Common_Delete}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: the editor for the selected set -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource CredBodyStyle}"
                               TextAlignment="Center"
                               Text="{x:Static res:Strings.Creds_NoSelection_Hint}"
                               Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                    <Grid Visibility="{Binding HasSelection, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Creds_Editor_Header}" />

                        <ScrollViewer Grid.Row="1" Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,10,0">
                            <StackPanel>

                                <TextBlock Style="{StaticResource CredFieldLabelStyle}" Text="{x:Static res:Strings.Creds_Field_Name}" />
                                <TextBox x:Name="NameBox"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="120" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource CredFieldLabelStyle}" Text="{x:Static res:Strings.Creds_Field_Domain}" />
                                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding EditDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="120" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource CredFieldLabelStyle}" Text="{x:Static res:Strings.Creds_Field_Username}" />
                                        <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                 Text="{Binding EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="256" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.Creds_Domain_Hint}" />

                                <TextBlock Margin="0,10,0,0" Style="{StaticResource CredFieldLabelStyle}" Text="{x:Static res:Strings.Creds_Field_Password}" />

                                <!-- A password is on file and has not been touched. -->
                                <Grid Visibility="{Binding ShowStoredPasswordHint, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource StatusPillStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource CredIconLock}"
                                                  Width="11" Height="11" Stretch="Uniform"
                                                  Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Static res:Strings.Creds_PasswordStored}"
                                                       Margin="6,0,0,0"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="1"
                                            Content="{x:Static res:Strings.Creds_ChangePassword}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Command="{Binding ChangePasswordCommand}"
                                            ToolTip="{x:Static res:Strings.Creds_ChangePassword_Tooltip}" />
                                </Grid>

                                <!-- The box is live: typing here replaces the stored password. -->
                                <Grid Visibility="{Binding ShowPasswordBox, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PasswordInput"
                                                 Grid.Column="0"
                                                 Style="{StaticResource AppPasswordBoxStyle}"
                                                 PasswordChanged="OnPasswordChanged" />
                                    <Button Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Content="{x:Static res:Strings.Creds_KeepPassword}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Command="{Binding KeepPasswordCommand}"
                                            Visibility="{Binding HasStoredPassword, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"
                                            ToolTip="{x:Static res:Strings.Creds_KeepPassword_Tooltip}" />
                                </Grid>

                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource CredHintStyle}"
                                           Text="{x:Static res:Strings.Creds_Password_Hint}" />

                                <TextBlock Margin="0,12,0,0" Style="{StaticResource CredFieldLabelStyle}" Text="{x:Static res:Strings.Creds_Field_Notes}" />
                                <TextBox Style="{StaticResource AppTextBoxStyle}"
                                         Height="66"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding EditNotes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         MaxLength="2000" />

                                <CheckBox Margin="0,14,0,0"
                                          Style="{StaticResource AppToggleStyle}"
                                          Content="{x:Static res:Strings.Creds_IsDefault}"
                                          IsChecked="{Binding EditIsDefault, Mode=TwoWay}" />
                                <TextBlock Margin="48,4,0,0"
                                           Style="{StaticResource CredHintStyle}"
                                           Text="{x:Static res:Strings.Creds_IsDefault_Hint}" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{x:Static res:Strings.Creds_Revert}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Command="{Binding RevertCommand}"
                                    MinWidth="88" />
                            <Button Margin="8,0,0,0"
                                    Content="{x:Static res:Strings.Common_Save}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================================== the Windows Credential Vault -->
        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title + the explanation of what this pane touches -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CredIconLock}"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Margin="6,0,0,6"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Text="{x:Static res:Strings.Vault_Header}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CredBodyStyle}"
                               MaxWidth="900"
                               HorizontalAlignment="Left"
                               Text="{x:Static res:Strings.Vault_Intro}" />
                </StackPanel>

                <!-- Toolbar: refresh, host, apply -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="300" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshVaultCommand}"
                            ToolTip="{x:Static res:Strings.Vault_Refresh_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CredIconRefresh}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.Vault_Refresh}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Margin="14,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{x:Static res:Strings.Vault_Host}" />

                    <TextBox Grid.Column="2"
                             Style="{StaticResource AppTextBoxStyle}"
                             Text="{Binding VaultHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="255"
                             ToolTip="{x:Static res:Strings.Vault_Host_Tooltip}" />

                    <Button Grid.Column="3"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ApplyToHostCommand}"
                            ToolTip="{x:Static res:Strings.Vault_ApplyToHost_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CredIconArrowRight}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Strings.Vault_ApplyToHost}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="4"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding VaultSummary}" />
                </Grid>

                <!-- Write method -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <CheckBox Style="{StaticResource AppToggleStyle}"
                              Content="{x:Static res:Strings.Vault_UseCmdKey}"
                              IsChecked="{Binding UseCmdKey, Mode=TwoWay}" />
                    <TextBlock Margin="48,4,0,0"
                               Style="{StaticResource CredHintStyle}"
                               Text="{Binding WriteMethodExplanation}" />
                </StackPanel>

                <!-- Column headers, aligned with the item template below -->
                <Grid Grid.Row="3" Margin="12,12,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CredColumnHeaderStyle}" Text="{x:Static res:Strings.Vault_Column_Host}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CredColumnHeaderStyle}" Text="{x:Static res:Strings.Vault_Column_Username}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Style="{StaticResource CredColumnHeaderStyle}" Text="{x:Static res:Strings.Vault_Column_Type}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="3" Style="{StaticResource CredColumnHeaderStyle}" Text="{x:Static res:Strings.Vault_Column_Persistence}" Margin="8,0,0,0" />
                </Grid>

                <Grid Grid.Row="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource CredHintStyle}"
                               Text="{x:Static res:Strings.Vault_Empty}"
                               Visibility="{Binding HasVaultEntries, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                    <ListBox Style="{StaticResource AppListBoxStyle}"
                             ItemsSource="{Binding VaultEntries}"
                             SelectedItem="{Binding SelectedVaultEntry, Mode=TwoWay}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             Visibility="{Binding HasVaultEntries, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Host}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding TargetName}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource CredCellStyle}"
                                               Text="{Binding Username}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource CredCellStyle}"
                                               Text="{Binding TypeName}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="8,0,0,0"
                                               Style="{StaticResource CredCellStyle}"
                                               Text="{Binding PersistName}" />

                                    <Button Grid.Column="4"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            Command="{Binding DataContext.DeleteVaultEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{x:Static res:Strings.Vault_RemoveEntry_Tooltip}">
                                        <Path Data="{StaticResource CredIconTrash}"
                                              Width="13" Height="13" Stretch="Uniform"
                                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Equivalent commands -->
                <StackPanel Grid.Row="5" Margin="0,10,0,0">
                    <Button HorizontalAlignment="Left"
                            Padding="6,3"
                            MinHeight="24"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{Binding ToggleCommandsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CredIconChevronRight}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ShowCommands, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />
                            <Path Data="{StaticResource CredIconChevronDown}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ShowCommands, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{x:Static res:Strings.Vault_Commands_Toggle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Margin="0,6,0,0"
                            Style="{StaticResource CardBorderStyle}"
                            Background="{DynamicResource SurfaceAltBrush}"
                            Padding="10"
                            Visibility="{Binding ShowCommands, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CredCodeStyle}" Text="{Binding ListCommandText}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CredCodeStyle}" Text="{Binding DeleteCommandText}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CredCodeStyle}" Text="{Binding GenericCommandText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{x:Static res:Strings.Vault_Commands_Copy}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CopyCommandsCommand}"
                                    ToolTip="{x:Static res:Strings.Vault_Commands_Copy_Tooltip}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource CredStatusStyle}" Text="{Binding Status}" />
            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    Content="{x:Static res:Strings.Common_Close}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
