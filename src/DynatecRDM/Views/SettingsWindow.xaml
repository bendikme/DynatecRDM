<Window x:Class="DynatecRDM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        xmlns:res="clr-namespace:DynatecRDM.Resources"
        Style="{StaticResource AppWindowStyle}"
        Title="{x:Static res:Strings.Settings_Title}"
        Width="820"
        Height="860"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- Icons: 24x24 path geometries, local to this file. -->
        <PathGeometry x:Key="SetIconFolder" Figures="M 3,18.5 L 3,5.5 L 9.5,5.5 L 11.5,8 L 21,8 L 21,18.5 Z" />
        <PathGeometry x:Key="SetIconDocument" Figures="M 6,3 L 14,3 L 19,8 L 19,21 L 6,21 Z M 14,3 L 14,8 L 19,8 M 9,12.5 L 16,12.5 M 9,16 L 16,16" />
        <PathGeometry x:Key="SetIconTrash" Figures="M 4,7 L 20,7 M 10,7 L 10,4 L 14,4 L 14,7 M 6.5,7 L 7.6,20 L 16.4,20 L 17.5,7" />

        <Style x:Key="SetCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="SetLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SetHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <Style x:Key="SetToggleHintStyle" TargetType="TextBlock" BasedOn="{StaticResource SetHintStyle}">
            <Setter Property="Margin" Value="48,3,0,0" />
        </Style>

        <Style x:Key="SetNumberBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Width" Value="86" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="6" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>

        <Style x:Key="SetErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SetStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.Settings_Title}"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="{StaticResource FontSizeNormal}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{x:Static res:Strings.Settings_Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,12,0">
            <StackPanel>

                <!-- ================================================== startup -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Startup_Header}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_Startup_StartInTray}"
                                  IsChecked="{Binding StartInTray, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Startup_StartInTray_Hint}" />

                        <CheckBox Margin="0,12,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_Startup_CloseToTray}"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Startup_CloseToTray_Hint}" />

                        <CheckBox Margin="0,12,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_Startup_LaunchAtLogon}"
                                  IsChecked="{Binding LaunchAtLogon, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Startup_LaunchAtLogon_Hint}" />
                    </StackPanel>
                </Border>

                <!-- ============================================== quick launch -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_QuickLaunch_Header}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_QuickLaunch_Hotkey}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_QuickLaunch_Hotkey_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Width="150"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     MaxLength="64"
                                     Text="{Binding HotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Style="{StaticResource SetErrorStyle}"
                                   Text="{Binding HotkeyError}"
                                   Visibility="{Binding HotkeyError, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                        <CheckBox Margin="0,14,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_QuickLaunch_ShowGroups}"
                                  IsChecked="{Binding ShowGroupsInTray, Mode=TwoWay}" />

                        <CheckBox Margin="0,12,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_QuickLaunch_ShowThumbnails}"
                                  IsChecked="{Binding ShowSnapshotsInTray, Mode=TwoWay}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_QuickLaunch_MaxItems}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_QuickLaunch_MaxItems_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding TrayMenuMaxItems, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================== full screen -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_FullScreen_Header}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_FullScreen_SessionBar}"
                                  IsChecked="{Binding SessionBarEnabled, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_FullScreen_SessionBar_Hint}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_FullScreen_ConnectionBar_Hint}" />
                    </StackPanel>
                </Border>

                <!-- ================================================ snapshots -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Snapshots_Header}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_Snapshots_Enable}"
                                  IsChecked="{Binding EnableSnapshots, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Snapshots_Enable_Hint}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Snapshots_Interval}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_Snapshots_Interval_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding SnapshotIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Snapshots_MaxEdge}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_Snapshots_MaxEdge_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding SnapshotMaxEdge, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Snapshots_Quality}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_Snapshots_Quality_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding SnapshotQuality, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Snapshots_Stored}" />
                                <TextBlock Style="{StaticResource SetHintStyle}" Text="{Binding SnapshotFolderText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearSnapshotsCommand}"
                                    ToolTip="{x:Static res:Strings.Settings_Snapshots_Clear_Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SetIconTrash}"
                                          Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Strings.Settings_Snapshots_Clear}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================================================= watchdog -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Watchdog_Header}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_Watchdog_Enable}"
                                  IsChecked="{Binding WatchdogEnabled, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Watchdog_Enable_Hint}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Watchdog_Interval}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_Watchdog_Interval_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding WatchdogPollSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================================== remote desktop client -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Client_Header}" />

                        <TextBlock Style="{StaticResource SetHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Client_Intro}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Margin="0,12,0,0"
                                  Content="{x:Static res:Strings.Settings_Client_UseEmbedded}"
                                  IsChecked="{Binding UseEmbeddedClient, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{Binding EmbeddedClientStateText}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_ConnectTimeout}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_ConnectTimeout_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding ConnectTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ========================================= connection files -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Files_Header}" />

                        <TextBlock Style="{StaticResource SetHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Files_Intro}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Margin="0,12,0,0"
                                  Content="{x:Static res:Strings.Settings_Files_Sign}"
                                  IsChecked="{Binding SignRdpFiles, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{Binding SigningStateText}" />

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Files_Thumbprint}" />
                            <TextBlock Style="{StaticResource SetHintStyle}"
                                       Text="{x:Static res:Strings.Settings_Files_Thumbprint_Hint}" />
                            <TextBox Style="{StaticResource AppTextBoxStyle}"
                                     Margin="0,6,0,0"
                                     Text="{Binding SigningThumbprint, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================================================== updates -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Updates_Header}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_Updates_Enable}"
                                  IsChecked="{Binding UpdateCheckEnabled, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{Binding UpdateStateText}" />

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Updates_Repository}" />
                            <TextBlock Style="{StaticResource SetHintStyle}"
                                       Text="{x:Static res:Strings.Settings_Updates_Repository_Hint}" />
                            <TextBox Style="{StaticResource AppTextBoxStyle}"
                                     Margin="0,6,0,0"
                                     Text="{Binding UpdateRepository, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding UpdateRepositoryError}"
                                       Visibility="{Binding HasUpdateRepositoryError, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Updates_Token}" />
                            <TextBlock Style="{StaticResource SetHintStyle}"
                                       Text="{x:Static res:Strings.Settings_Updates_Token_Hint}" />
                            <TextBox Style="{StaticResource AppTextBoxStyle}"
                                     Margin="0,6,0,0"
                                     Text="{Binding UpdateAccessToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Updates_Interval}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_Updates_Interval_Hint}" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding UpdateCheckIntervalHours, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Margin="0,14,0,0"
                                  Content="{x:Static res:Strings.Settings_Updates_Prereleases}"
                                  IsChecked="{Binding UpdateIncludePrereleases, Mode=TwoWay}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Margin="0,10,0,0"
                                  Content="{x:Static res:Strings.Settings_Updates_AutoInstall}"
                                  IsChecked="{Binding UpdateInstallAutomatically, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Updates_AutoInstall_Hint}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{x:Static res:Strings.Settings_Updates_CheckNow}"
                                    Command="{Binding CheckForUpdatesCommand}" />
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="{x:Static res:Strings.Settings_Updates_Transfer}"
                                    Command="{Binding OpenTransferCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SetHintStyle}"
                                   Margin="0,8,0,0"
                                   Text="{Binding LastUpdateCheckText}" />
                    </StackPanel>
                </Border>

                <!-- ================================================= security -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Security_Header}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Security_Delivery}" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="{x:Static res:Strings.Settings_Security_Delivery_Hint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="220"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      SelectedIndex="{Binding CredentialDeliveryIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{x:Static res:Strings.Settings_Security_Delivery_Vault}" />
                                <ComboBoxItem Content="{x:Static res:Strings.Settings_Security_Delivery_Embedded}" />
                                <ComboBoxItem Content="{x:Static res:Strings.Settings_Security_Delivery_Both}" />
                                <ComboBoxItem Content="{x:Static res:Strings.Settings_Security_Delivery_Prompt}" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Security_VaultMethod}" />
                                <TextBlock Style="{StaticResource SetHintStyle}" Text="{Binding VaultWriteMethodExplanation}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="220"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      SelectedIndex="{Binding VaultWriteMethodIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{x:Static res:Strings.Settings_Security_VaultMethod_Api}" />
                                <ComboBoxItem Content="cmdkey.exe" />
                            </ComboBox>
                        </Grid>

                        <CheckBox Margin="0,16,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_Security_Shred}"
                                  IsChecked="{Binding ShredRdpFiles, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Security_Shred_Hint}" />
                    </StackPanel>
                </Border>

                <!-- ================================================= language -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Language_Header}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Language_Label}" />
                                <TextBlock Style="{StaticResource SetHintStyle}" Text="{x:Static res:Strings.Language_Hint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="220"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      ItemsSource="{Binding LanguageOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding Language, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- =============================================== appearance -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_Appearance_Header}" />

                        <TextBlock Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_Appearance_Accent}" />
                        <ListBox Margin="0,6,0,0"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource AppListBoxStyle}"
                                 ItemsSource="{Binding AccentSwatches}"
                                 SelectedItem="{Binding AccentColor, Mode=TwoWay}"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"
                                                            VirtualizingStackPanel.IsVirtualizing="True"
                                                            VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            BorderBrush="{DynamicResource BorderBrushStrong}"
                                            BorderThickness="1"
                                            ToolTip="{Binding}"
                                            Background="{Binding Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SetHintStyle}"
                                   Text="{x:Static res:Strings.Settings_Appearance_Accent_Hint}" />

                        <CheckBox Margin="0,14,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="{x:Static res:Strings.Settings_Appearance_ConfirmClose}"
                                  IsChecked="{Binding ConfirmSessionClose, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== about -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Static res:Strings.Settings_About_Header}" />

                        <TextBlock Style="{StaticResource SetLabelStyle}"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProductName}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource SetHintStyle}" Text="{x:Static res:Strings.Settings_About_Publisher}" />
                            <TextBlock Margin="4,0,0,0" Style="{StaticResource SetHintStyle}" Text="{Binding Publisher}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource SetHintStyle}" Text="{x:Static res:Strings.Settings_About_Version}" />
                            <TextBlock Margin="4,0,0,0" Style="{StaticResource SetHintStyle}" Text="{Binding VersionText}" />
                        </StackPanel>

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource SetLabelStyle}" Text="{x:Static res:Strings.Settings_About_DataFolder}" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource SetHintStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding DataFolder}"
                                   Text="{Binding DataFolder}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenDataFolderCommand}"
                                    ToolTip="{x:Static res:Strings.Settings_About_OpenFolder_Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SetIconFolder}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Strings.Settings_About_OpenFolder}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenLogCommand}"
                                    ToolTip="{x:Static res:Strings.Settings_About_OpenLog_Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SetIconDocument}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Strings.Settings_About_OpenLog}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SetStatusStyle}" Text="{Binding Status}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="{x:Static res:Strings.Common_Cancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" />
                <Button Margin="8,0,0,0"
                        Content="{x:Static res:Strings.Common_Save}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
