<Window x:Class="DynatecRDM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        Style="{StaticResource AppWindowStyle}"
        Title="Settings"
        Width="660"
        Height="820"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- Icons: 24x24 path geometries, local to this file. -->
        <PathGeometry x:Key="SetIconFolder" Figures="M 3,18.5 L 3,5.5 L 9.5,5.5 L 11.5,8 L 21,8 L 21,18.5 Z" />
        <PathGeometry x:Key="SetIconDocument" Figures="M 6,3 L 14,3 L 19,8 L 19,21 L 6,21 Z M 14,3 L 14,8 L 19,8 M 9,12.5 L 16,12.5 M 9,16 L 16,16" />
        <PathGeometry x:Key="SetIconTrash" Figures="M 4,7 L 20,7 M 10,7 L 10,4 L 14,4 L 14,7 M 6.5,7 L 7.6,20 L 16.4,20 L 17.5,7" />

        <Style x:Key="SetCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="SetLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SetHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <Style x:Key="SetToggleHintStyle" TargetType="TextBlock" BasedOn="{StaticResource SetHintStyle}">
            <Setter Property="Margin" Value="48,3,0,0" />
        </Style>

        <Style x:Key="SetNumberBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Width" Value="86" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="6" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>

        <Style x:Key="SetErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SetStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Settings"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="{StaticResource FontSizeNormal}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Changes are applied when you save." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,12,0">
            <StackPanel>

                <!-- ================================================== startup -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="STARTUP" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="Start in the notification area"
                                  IsChecked="{Binding StartInTray, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="The main window stays hidden until you open it from the tray icon." />

                        <CheckBox Margin="0,12,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="Close button hides to the notification area"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="Turn this off to make the close button exit the application." />

                        <CheckBox Margin="0,12,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="Launch at logon"
                                  IsChecked="{Binding LaunchAtLogon, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="Registers the app under the current user's Run key. The state shown here is read back from the registry." />
                    </StackPanel>
                </Border>

                <!-- ============================================== quick launch -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="QUICK LAUNCH" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Global shortcut" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="For example Ctrl+Alt+R. Leave it empty to turn the shortcut off." />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Width="150"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     MaxLength="64"
                                     Text="{Binding HotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Style="{StaticResource SetErrorStyle}"
                                   Text="{Binding HotkeyError}"
                                   Visibility="{Binding HotkeyError, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                        <CheckBox Margin="0,14,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="Show groups in the tray menu"
                                  IsChecked="{Binding ShowGroupsInTray, Mode=TwoWay}" />

                        <CheckBox Margin="0,12,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="Show session thumbnails in the tray menu"
                                  IsChecked="{Binding ShowSnapshotsInTray, Mode=TwoWay}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Tray menu maximum items" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="Keeps the popup short on large connection lists (5 to 200)." />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding TrayMenuMaxItems, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================================================ snapshots -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="SNAPSHOTS" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="Capture session thumbnails"
                                  IsChecked="{Binding EnableSnapshots, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="Thumbnails are captured on a background thread and stored as JPEG files in the data folder." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Refresh interval" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="Seconds between background captures. 0 captures only on demand." />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding SnapshotIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Longest edge" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="Pixels on the longer side of a stored thumbnail (48 to 4096)." />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding SnapshotMaxEdge, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="JPEG quality" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="1 to 100. Lower values write smaller files." />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding SnapshotQuality, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Stored snapshots" />
                                <TextBlock Style="{StaticResource SetHintStyle}" Text="{Binding SnapshotFolderText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearSnapshotsCommand}"
                                    ToolTip="Delete every stored thumbnail">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SetIconTrash}"
                                          Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Clear snapshots" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================================================= watchdog -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="WATCHDOG" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="Watch sessions and reconnect them"
                                  IsChecked="{Binding WatchdogEnabled, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="The watchdog checks every live session window on a timer and relaunches any connection that drops, until its own reconnect limit is reached." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Poll interval" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="Seconds between health checks (1 to 120)." />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding WatchdogPollSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================================================== updates -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="UPDATES" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Content="Check GitHub for new releases"
                                  IsChecked="{Binding UpdateCheckEnabled, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="{Binding UpdateStateText}" />

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource SetLabelStyle}" Text="Release repository" />
                            <TextBlock Style="{StaticResource SetHintStyle}"
                                       Text="The GitHub repository releases are published to, as owner/repo. Leave empty to turn update checking off." />
                            <TextBox Style="{StaticResource AppTextBoxStyle}"
                                     Margin="0,6,0,0"
                                     Text="{Binding UpdateRepository, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding UpdateRepositoryError}"
                                       Visibility="{Binding HasUpdateRepositoryError, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource SetLabelStyle}" Text="Access token" />
                            <TextBlock Style="{StaticResource SetHintStyle}"
                                       Text="Only needed for a private repository. Public repositories need nothing here." />
                            <TextBox Style="{StaticResource AppTextBoxStyle}"
                                     Margin="0,6,0,0"
                                     Text="{Binding UpdateAccessToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Check every" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="Hours between background checks (1 to 720)." />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SetNumberBoxStyle}"
                                     Text="{Binding UpdateCheckIntervalHours, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Margin="0,14,0,0"
                                  Content="Include pre-release builds"
                                  IsChecked="{Binding UpdateIncludePrereleases, Mode=TwoWay}" />

                        <CheckBox Style="{StaticResource AppToggleStyle}"
                                  Margin="0,10,0,0"
                                  Content="Download and install without asking"
                                  IsChecked="{Binding UpdateInstallAutomatically, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="The installer is per-user, so an update never prompts for administrator rights. Your connections and credentials live outside the install folder and are untouched by an update." />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Check for updates"
                                    Command="{Binding CheckForUpdatesCommand}" />
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="Export or import configurations"
                                    Command="{Binding OpenTransferCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SetHintStyle}"
                                   Margin="0,8,0,0"
                                   Text="{Binding LastUpdateCheckText}" />
                    </StackPanel>
                </Border>

                <!-- ================================================= security -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="SECURITY" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Default credential delivery" />
                                <TextBlock Style="{StaticResource SetHintStyle}"
                                           Text="How new connections hand the password to mstsc." />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="220"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      SelectedIndex="{Binding CredentialDeliveryIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Windows Credential Vault" />
                                <ComboBoxItem Content="Embedded in the .rdp file" />
                                <ComboBoxItem Content="Both (most reliable)" />
                                <ComboBoxItem Content="Always prompt" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SetLabelStyle}" Text="Vault write method" />
                                <TextBlock Style="{StaticResource SetHintStyle}" Text="{Binding VaultWriteMethodExplanation}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="220"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      SelectedIndex="{Binding VaultWriteMethodIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Windows credential API" />
                                <ComboBoxItem Content="cmdkey.exe" />
                            </ComboBox>
                        </Grid>

                        <CheckBox Margin="0,16,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="Delete generated .rdp files after launch"
                                  IsChecked="{Binding ShredRdpFiles, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SetToggleHintStyle}"
                                   Text="A generated .rdp file can carry the password as an encrypted blob, so leaving it in the temp folder leaves a usable copy of the login behind." />
                    </StackPanel>
                </Border>

                <!-- =============================================== appearance -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="APPEARANCE" />

                        <TextBlock Style="{StaticResource SetLabelStyle}" Text="Accent colour" />
                        <ListBox Margin="0,6,0,0"
                                 HorizontalAlignment="Left"
                                 Style="{StaticResource AppListBoxStyle}"
                                 ItemsSource="{Binding AccentSwatches}"
                                 SelectedItem="{Binding AccentColor, Mode=TwoWay}"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"
                                                            VirtualizingStackPanel.IsVirtualizing="True"
                                                            VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="{StaticResource RadiusSmall}"
                                            BorderBrush="{StaticResource BorderBrushStrong}"
                                            BorderThickness="1"
                                            ToolTip="{Binding}"
                                            Background="{Binding Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SetHintStyle}"
                                   Text="The accent is applied across the app when you save." />

                        <CheckBox Margin="0,14,0,0"
                                  Style="{StaticResource AppToggleStyle}"
                                  Content="Confirm before closing a running session"
                                  IsChecked="{Binding ConfirmSessionClose, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- ==================================================== about -->
                <Border Style="{StaticResource SetCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ABOUT" />

                        <TextBlock Style="{StaticResource SetLabelStyle}"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProductName}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource SetHintStyle}" Text="Version" />
                            <TextBlock Margin="4,0,0,0" Style="{StaticResource SetHintStyle}" Text="{Binding VersionText}" />
                        </StackPanel>

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource SetLabelStyle}" Text="Data folder" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource SetHintStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding DataFolder}"
                                   Text="{Binding DataFolder}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenDataFolderCommand}"
                                    ToolTip="Open the data folder in File Explorer">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SetIconFolder}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Open folder" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenLogCommand}"
                                    ToolTip="Open the application log">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SetIconDocument}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Open log" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SetStatusStyle}" Text="{Binding Status}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}" />
                <Button Margin="8,0,0,0"
                        Content="Save"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
