<Window x:Class="DynatecRDM.Views.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        Style="{StaticResource AppWindowStyle}"
        Title="Export and import"
        Width="720"
        Height="640"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- Icons: 24x24 path geometries, local to this file. -->
        <PathGeometry x:Key="TrIconFile" Figures="M 6,3 L 14,3 L 19,8 L 19,21 L 6,21 Z M 14,3 L 14,8 L 19,8" />
        <PathGeometry x:Key="TrIconDatabase" Figures="M 12,3 C 16.4,3 20,4.3 20,6 C 20,7.7 16.4,9 12,9 C 7.6,9 4,7.7 4,6 C 4,4.3 7.6,3 12,3 Z M 4,6 L 4,18 C 4,19.7 7.6,21 12,21 C 16.4,21 20,19.7 20,18 L 20,6 M 4,12 C 4,13.7 7.6,15 12,15 C 16.4,15 20,13.7 20,12" />
        <PathGeometry x:Key="TrIconAlert" Figures="M 12,3.6 L 22.2,20.4 L 1.8,20.4 Z M 12,9.6 L 12,14.8 M 12,17.5 L 12,17.6" />
        <PathGeometry x:Key="TrIconUpload" Figures="M 12,20 L 12,8 M 6.5,13.5 L 12,8 L 17.5,13.5 M 4,3.5 L 20,3.5" />

        <Style x:Key="TrCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="TrLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TrBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style x:Key="TrHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <Style x:Key="TrRadioHintStyle" TargetType="TextBlock" BasedOn="{StaticResource TrHintStyle}">
            <Setter Property="Margin" Value="24,2,0,0" />
        </Style>

        <Style x:Key="TrFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="TrErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="TrCountValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="TrCountLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- The stock progress bar template is used as-is; only its colours are themed. -->
        <Style x:Key="TrProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="TrMessageStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================
             Radio button. The shared dictionary has no radio style, so
             one is built here from the shared palette only.
             ============================================================ -->

        <Style x:Key="TrRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Ring"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="8"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrushStrong}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Ellipse x:Name="Dot"
                                         Width="7"
                                         Height="7"
                                         Visibility="Collapsed"
                                         Fill="{StaticResource TextPrimaryBrush}" />
                            </Border>
                            <ContentPresenter x:Name="Cp"
                                              Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================ header -->

        <StackPanel Grid.Row="0" Margin="20,18,20,0">
            <TextBlock Text="Export and import"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource TrBodyStyle}"
                       Text="Move configurations between machines, or keep a copy of the whole library." />
        </StackPanel>

        <!-- ================================================================ tabs -->

        <TabControl Grid.Row="1"
                    Margin="20,14,20,0"
                    Style="{StaticResource AppTabControlStyle}"
                    SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ============================================================ export -->

            <TabItem Header="Export">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,6,0">
                        <StackPanel>

                            <!-- what to export -->
                            <Border Style="{StaticResource TrCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="WHAT TO EXPORT" />
                                    <RadioButton GroupName="ExportScope"
                                                 Style="{StaticResource TrRadioStyle}"
                                                 Content="Everything in the library"
                                                 IsChecked="{Binding ExportEverything}" />
                                    <TextBlock Style="{StaticResource TrRadioHintStyle}"
                                               Text="Every group, connection and multi-config you have." />
                                    <RadioButton Margin="0,10,0,0"
                                                 GroupName="ExportScope"
                                                 Style="{StaticResource TrRadioStyle}"
                                                 Content="Only what I choose"
                                                 IsChecked="{Binding ExportChosenOnly}" />
                                </StackPanel>
                            </Border>

                            <!-- picker -->
                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource TrCardStyle}"
                                    IsEnabled="{Binding ExportChosenOnly}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <TextBox Style="{StaticResource AppTextBoxStyle}"
                                                     MaxLength="128"
                                                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                            <TextBlock Margin="11,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="Search connections and multi-configs"
                                                       Visibility="{Binding Search, Converter={x:Static conv:StringToVisibilityConverter.Instance}, ConverterParameter=invert}" />
                                        </Grid>

                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Content="Select all"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Command="{Binding SelectAllCommand}" />
                                        <Button Grid.Column="2"
                                                Margin="2,0,0,0"
                                                Content="Select none"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Command="{Binding SelectNoneCommand}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="10,0,2,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding SelectionText}" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <ListBox MinHeight="150"
                                                 MaxHeight="280"
                                                 Style="{StaticResource AppListBoxStyle}"
                                                 ItemsSource="{Binding Items}"
                                                 SelectionMode="Single"
                                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource AppCheckBoxStyle}"
                                                                  IsChecked="{Binding IsSelected}" />

                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Border Grid.Column="2"
                                                                Margin="10,0,0,0"
                                                                Style="{StaticResource StatusPillStyle}">
                                                            <TextBlock Text="{Binding Kind}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <ListBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                                                                <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                                                           Margin="0"
                                                                           Text="{Binding Name}" />
                                                                <TextBlock Margin="8,0,0,0"
                                                                           FontSize="{StaticResource FontSizeSmall}"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="{Binding ItemCount}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListBox.GroupStyle>
                                        </ListBox>

                                        <TextBlock VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Style="{StaticResource TrHintStyle}"
                                                   Text="Reading the library..."
                                                   Visibility="{Binding IsLoadingItems, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- options -->
                            <Border Margin="0,10,0,0" Style="{StaticResource TrCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="OPTIONS" />

                                    <CheckBox Style="{StaticResource AppCheckBoxStyle}"
                                              Content="Include saved passwords"
                                              IsChecked="{Binding IncludeCredentials}" />

                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IncludeCredentials, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Style="{StaticResource TrBodyStyle}"
                                                   Text="Windows ties your stored passwords to this user account and this PC, so they are re-encrypted with a passphrase you choose here. Whoever imports the file has to type the same passphrase - it is not stored anywhere and cannot be recovered." />

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Style="{StaticResource TrFieldLabelStyle}" Text="Passphrase" />
                                                <PasswordBox x:Name="ExportPassphraseBox"
                                                             Style="{StaticResource AppPasswordBoxStyle}"
                                                             MaxLength="256"
                                                             PasswordChanged="OnExportPassphraseChanged" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Style="{StaticResource TrFieldLabelStyle}" Text="Repeat the passphrase" />
                                                <PasswordBox x:Name="ExportPassphraseConfirmBox"
                                                             Style="{StaticResource AppPasswordBoxStyle}"
                                                             MaxLength="256"
                                                             PasswordChanged="OnExportPassphraseConfirmChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Style="{StaticResource TrErrorStyle}"
                                                   Text="{Binding PassphraseError}"
                                                   Visibility="{Binding PassphraseError, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                                    </StackPanel>

                                    <CheckBox Margin="0,12,0,0"
                                              Style="{StaticResource AppCheckBoxStyle}"
                                              Content="Include application settings"
                                              IsChecked="{Binding IncludeSettings}"
                                              IsEnabled="{Binding CanIncludeSettings}" />
                                    <TextBlock Style="{StaticResource TrRadioHintStyle}"
                                               Text="Only travels with a full-library export. Settings are written into the file for reference; importing one never changes the settings on this PC." />
                                </StackPanel>
                            </Border>

                            <!-- result -->
                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource TrCardStyle}"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Padding="12"
                                    Visibility="{Binding HasExportResult, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TrLabelStyle}" Text="{Binding ExportSummary}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource TrHintStyle}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExportPath}"
                                               Text="{Binding ExportPath}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- actions -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BackupCommand}"
                                ToolTip="Copies the whole database file, exactly as it is on disk">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource TrIconDatabase}"
                                      Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Back up database..." Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExportCommand}"
                                IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource TrIconUpload}"
                                      Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Export..." Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ import -->

            <TabItem Header="Import">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Style="{StaticResource AppScrollViewerStyle}" Padding="0,0,6,0">
                        <StackPanel>

                            <!-- file -->
                            <Border Style="{StaticResource TrCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0"
                                          Width="20" Height="20"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Data="{StaticResource TrIconFile}"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TrLabelStyle}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ImportFileName}"
                                                   Visibility="{Binding HasFile, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Style="{StaticResource TrLabelStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="No file chosen yet"
                                                   Visibility="{Binding HasFile, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource TrHintStyle}"
                                                   Text="Nothing is written to your library until you press Import." />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Margin="12,0,0,0"
                                            Content="Choose file..."
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ChooseFileCommand}" />
                                </Grid>
                            </Border>

                            <!-- preview -->
                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource TrCardStyle}"
                                    Visibility="{Binding HasPreview, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="WHAT THIS FILE HOLDS" />

                                    <UniformGrid Columns="4" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TrCountValueStyle}" Text="{Binding Preview.Groups}" />
                                            <TextBlock Style="{StaticResource TrCountLabelStyle}" Text="Groups" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TrCountValueStyle}" Text="{Binding Preview.Connections}" />
                                            <TextBlock Style="{StaticResource TrCountLabelStyle}" Text="Connections" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TrCountValueStyle}" Text="{Binding Preview.MultiConfigs}" />
                                            <TextBlock Style="{StaticResource TrCountLabelStyle}" Text="Multi-configs" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TrCountValueStyle}" Text="{Binding Preview.Credentials}" />
                                            <TextBlock Style="{StaticResource TrCountLabelStyle}" Text="Credentials" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Margin="0,12,0,0"
                                               Style="{StaticResource TrHintStyle}"
                                               Text="{Binding PreviewOriginText}" />

                                    <Border Margin="0,12,0,0"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource WarningBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            Padding="10,8"
                                            Visibility="{Binding Preview.Conflicts, Converter={x:Static conv:CountToVisibilityConverter.Instance}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Width="16" Height="16"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Data="{StaticResource TrIconAlert}"
                                                  Stroke="{StaticResource WarningBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontSize="{StaticResource FontSizeNormal}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding Preview.Conflicts, Mode=OneWay}" />
                                                <Run Text="of these already exist in your library. What happens to them is up to you, below." />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- passphrase -->
                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource TrCardStyle}"
                                    Visibility="{Binding NeedsPassphrase, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TrFieldLabelStyle}" Text="Passphrase" />
                                    <PasswordBox x:Name="ImportPassphraseBox"
                                                 Style="{StaticResource AppPasswordBoxStyle}"
                                                 MaxLength="256"
                                                 PasswordChanged="OnImportPassphraseChanged" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource TrHintStyle}"
                                               Text="This file carries saved passwords. They were locked with a passphrase when the file was written, and only that passphrase can open them again." />
                                </StackPanel>
                            </Border>

                            <!-- mode -->
                            <Border Margin="0,10,0,0" Style="{StaticResource TrCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="WHEN SOMETHING ALREADY EXISTS" />

                                    <RadioButton GroupName="ImportMode"
                                                 Style="{StaticResource TrRadioStyle}"
                                                 Content="Keep what I have"
                                                 IsChecked="{Binding Mode, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Skip}" />
                                    <TextBlock Style="{StaticResource TrRadioHintStyle}"
                                               Text="Anything already in your library is left exactly as it is." />

                                    <RadioButton Margin="0,10,0,0"
                                                 GroupName="ImportMode"
                                                 Style="{StaticResource TrRadioStyle}"
                                                 Content="Replace with the version in the file"
                                                 IsChecked="{Binding Mode, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Replace}" />
                                    <TextBlock Style="{StaticResource TrRadioHintStyle}"
                                               Text="Existing items are overwritten, so local changes to them are lost." />

                                    <RadioButton Margin="0,10,0,0"
                                                 GroupName="ImportMode"
                                                 Style="{StaticResource TrRadioStyle}"
                                                 Content="Import as copies"
                                                 IsChecked="{Binding Mode, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=DuplicateWithNewId}" />
                                    <TextBlock Style="{StaticResource TrRadioHintStyle}"
                                               Text="Nothing is touched; everything in the file is added alongside what you have." />
                                </StackPanel>
                            </Border>

                            <!-- result -->
                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource TrCardStyle}"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    Visibility="{Binding HasResult, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="RESULT" />

                                    <UniformGrid Columns="3">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TrCountValueStyle}" Text="{Binding AddedCount}" />
                                            <TextBlock Style="{StaticResource TrCountLabelStyle}" Text="Added" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TrCountValueStyle}" Text="{Binding Result.Replaced}" />
                                            <TextBlock Style="{StaticResource TrCountLabelStyle}" Text="Replaced" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TrCountValueStyle}" Text="{Binding Result.Skipped}" />
                                            <TextBlock Style="{StaticResource TrCountLabelStyle}" Text="Skipped" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Margin="0,10,0,0"
                                               Style="{StaticResource TrHintStyle}"
                                               Text="{Binding ResultDetailText}" />

                                    <ScrollViewer Margin="0,10,0,0"
                                                  MaxHeight="150"
                                                  Style="{StaticResource AppScrollViewerStyle}"
                                                  Visibility="{Binding Result.Warnings, Converter={x:Static conv:CountToVisibilityConverter.Instance}}">
                                        <ItemsControl ItemsSource="{Binding Result.Warnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,10,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="4" Height="4"
                                                                Margin="2,7,8,0"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Top"
                                                                Background="{StaticResource WarningBrush}" />
                                                        <TextBlock Grid.Column="1"
                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   LineHeight="17"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- action -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Button HorizontalAlignment="Right"
                                Content="Import"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ImportCommand}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================================================================ footer -->

        <Grid Grid.Row="2" Margin="20,12,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="10,6"
                    VerticalAlignment="Center"
                    Visibility="{Binding Message, Converter={x:Static conv:StringToVisibilityConverter.Instance}}">
                <TextBlock Style="{StaticResource TrMessageStyle}"
                           ToolTip="{Binding Message}"
                           Text="{Binding Message}" />
            </Border>

            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    Content="Close"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CloseCommand}" />
        </Grid>

        <!-- ================================================================ busy -->

        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Background="{StaticResource OverlayBrush}"
                Visibility="{Binding IsBusy, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="24,20"
                    MinWidth="260"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSizeNormal}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding BusyText}" />
                    <ProgressBar Style="{StaticResource TrProgressStyle}"
                                 Margin="0,14,0,0"
                                 IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
