<Window x:Class="DynatecRDM.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="Confirm"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <Window.Resources>
        <PathGeometry x:Key="ConfirmIconAlert"
                      Figures="M 12,3.6 L 22.2,20.4 L 1.8,20.4 Z M 12,9.6 L 12,14.8 M 12,17.5 L 12,17.6" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Path x:Name="AlertIcon"
                  Grid.Column="0"
                  Width="22" Height="22"
                  Margin="0,2,12,0"
                  VerticalAlignment="Top"
                  Stretch="Uniform"
                  Data="{StaticResource ConfirmIconAlert}"
                  Stroke="{StaticResource DangerBrush}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeadingText"
                           Text="Confirm"
                           FontSize="{StaticResource FontSizeMedium}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Margin="0,6,0,0"
                           FontSize="{StaticResource FontSizeNormal}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" />
            <Button x:Name="ConfirmButton"
                    Margin="8,0,0,0"
                    Content="Delete"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
