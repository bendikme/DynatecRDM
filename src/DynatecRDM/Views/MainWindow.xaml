<Window x:Class="DynatecRDM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DynatecRDM.Converters"
        xmlns:vm="clr-namespace:DynatecRDM.ViewModels"
        Title="DYNATEC Remote Desktop Manager"
        Style="{StaticResource AppWindowStyle}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ================================================================
             Icons - 24 x 24 path data, stroked, scaled by a Viewbox.
             Local to this window so nothing collides with the other views.
             ================================================================ -->

        <PathGeometry x:Key="GeoSearch"
                      Figures="M4,10.5 A6.5,6.5 0 1 1 17,10.5 A6.5,6.5 0 1 1 4,10.5 Z M15.4,15.4 L20,20" />
        <PathGeometry x:Key="GeoPlus" Figures="M12,5 L12,19 M5,12 L19,12" />
        <PathGeometry x:Key="GeoFolder" Figures="M3,6 L9,6 L11,9 L21,9 L21,19 L3,19 Z" />
        <PathGeometry x:Key="GeoLayers"
                      Figures="M12,3 L21,8 L12,13 L3,8 Z M3,12 L12,17 L21,12 M3,16 L12,21 L21,16" />
        <PathGeometry x:Key="GeoMonitor" Figures="M3,5 L21,5 L21,16 L3,16 Z M9,20 L15,20 M12,16 L12,20" />
        <PathGeometry x:Key="GeoCard" Figures="M3,6 L21,6 L21,18 L3,18 Z M3,10 L21,10 M6,14 L11,14" />
        <PathGeometry x:Key="GeoGear"
                      Figures="M12,8.6 A3.4,3.4 0 1 1 11.99,8.6 Z M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7.1,7.1 M16.9,16.9 L19.1,19.1 M19.1,4.9 L16.9,7.1 M7.1,16.9 L4.9,19.1" />
        <PathGeometry x:Key="GeoRefresh"
                      Figures="M4.5,12 A7.5,7.5 0 1 0 7.9,5.7 M7.9,2.2 L7.9,6.2 L11.9,6.2" />
        <PathGeometry x:Key="GeoImport" Figures="M12,3 L12,14 M7.5,9.5 L12,14 L16.5,9.5 M4,19 L20,19" />
        <PathGeometry x:Key="GeoTransfer" Figures="M8,20 L8,7 M4.5,10.5 L8,7 L11.5,10.5 M16,4 L16,17 M12.5,13.5 L16,17 L19.5,13.5" />
        <PathGeometry x:Key="GeoClose" Figures="M6,6 L18,18 M18,6 L6,18" />
        <PathGeometry x:Key="GeoStar"
                      Figures="M12,3.4 L14.6,9.2 L20.9,9.9 L16.2,14.1 L17.5,20.3 L12,17.1 L6.5,20.3 L7.8,14.1 L3.1,9.9 L9.4,9.2 Z" />

        <!-- ================================================================
             Local styles - built only from the shared palette and metrics.
             ================================================================ -->

        <Style x:Key="ToolbarIconStyle" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <!-- The tree icon must NOT set Data or Stroke locally: a local value outranks the
             DataTemplate triggers below, so the folder / layers icons would never appear.
             Both defaults therefore live here, where a trigger can override them. -->
        <Style x:Key="NodeIconStyle" TargetType="Path" BasedOn="{StaticResource ToolbarIconStyle}">
            <Setter Property="Data" Value="{StaticResource GeoMonitor}" />
            <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <!-- ================================================================
             Scrolling fixes.
             The shared AppListBoxStyle / AppTreeViewStyle templates wrap their
             ItemsPresenter in a plain ScrollViewer that does not forward the
             ScrollViewer.* attached properties. Those properties do not inherit, so the
             inner viewer keeps its own defaults: CanContentScroll=False (which switches
             virtualization off entirely) and VerticalScrollBarVisibility=Visible (a bar
             that is always on screen). These two copies forward them; everything else is
             identical to the shared template.
             ================================================================ -->

        <Style x:Key="ScrollingListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource AppListBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False"
                                          Padding="0"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter SnapsToDevicePixels="True" />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryTreeStyle" TargetType="TreeView" BasedOn="{StaticResource AppTreeViewStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False"
                                          Padding="0"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter SnapsToDevicePixels="True" />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree rows: expansion, selection and the search filter all live on the node. -->
        <Style x:Key="NodeContainerStyle" TargetType="TreeViewItem" BasedOn="{StaticResource AppTreeViewItemStyle}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility"
                    Value="{Binding IsVisible, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
        </Style>

        <!-- The session strip is a read-only card rail, so the item container is bare. -->
        <Style x:Key="SessionCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MultiItemContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItemStyle}">
            <Setter Property="Focusable" Value="False" />
        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewConnectionCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="N" Command="{Binding NewGroupCommand}" />
        <KeyBinding Modifiers="Control" Key="M" Command="{Binding NewMultiConfigCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding ImportRdpFileCommand}" />
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding ExportSelectedCommand}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding DuplicateSelectedCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             Title strip: brand, search, toolbar
             ============================================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                SnapsToDevicePixels="True">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DYNATEC"
                               FontSize="{StaticResource FontSizeMedium}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Remote Desktop Manager"
                               Margin="8,0,0,0"
                               FontSize="{StaticResource FontSizeNormal}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Column="1"
                      Width="380"
                      Margin="28,0,16,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource AppTextBoxStyle}"
                             Padding="32,5,30,5"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search connections, hosts and tags (Ctrl+F)" />

                    <Viewbox Width="14"
                             Height="14"
                             Margin="10,0,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False">
                        <Path Style="{StaticResource ToolbarIconStyle}"
                              Data="{StaticResource GeoSearch}"
                              Stroke="{StaticResource TextMutedBrush}" />
                    </Viewbox>

                    <TextBlock Text="Search"
                               Margin="34,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={x:Static conv:StringToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                    <Button Width="22"
                            Height="22"
                            MinWidth="0"
                            MinHeight="0"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="Clear the search"
                            Visibility="{Binding SearchText, Converter={x:Static conv:StringToVisibilityConverter.Instance}}">
                        <Viewbox Width="10" Height="10">
                            <Path Style="{StaticResource ToolbarIconStyle}"
                                  Data="{StaticResource GeoClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Viewbox>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding NewConnectionCommand}"
                            AutomationProperties.Name="New connection"
                            ToolTip="New connection (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Style="{StaticResource ToolbarIconStyle}"
                                      Data="{StaticResource GeoPlus}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Viewbox>
                            <TextBlock Text="Connection" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Margin="2,0,0,0"
                            Command="{Binding NewMultiConfigCommand}"
                            AutomationProperties.Name="New multi-config"
                            ToolTip="New multi-config (Ctrl+M)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Style="{StaticResource ToolbarIconStyle}"
                                      Data="{StaticResource GeoLayers}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Viewbox>
                            <TextBlock Text="Multi-config" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Margin="2,0,0,0"
                            Command="{Binding NewGroupCommand}"
                            AutomationProperties.Name="New group"
                            ToolTip="New group (Ctrl+Shift+N)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Style="{StaticResource ToolbarIconStyle}"
                                      Data="{StaticResource GeoFolder}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Viewbox>
                            <TextBlock Text="Group" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1"
                            Height="20"
                            Margin="8,0"
                            Background="{StaticResource BorderBrushSoft}"
                            SnapsToDevicePixels="True" />

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Padding="7,0"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ImportRdpFileCommand}"
                            AutomationProperties.Name="Import a .rdp file"
                            ToolTip="Import a .rdp file (Ctrl+O)">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource ToolbarIconStyle}"
                                  Data="{StaticResource GeoImport}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Padding="7,0"
                            HorizontalContentAlignment="Center"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="Reload the library"
                            ToolTip="Reload the library (F5)">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource ToolbarIconStyle}"
                                  Data="{StaticResource GeoRefresh}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Padding="7,0"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenCredentialsCommand}"
                            AutomationProperties.Name="Credential manager"
                            ToolTip="Credential manager">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource ToolbarIconStyle}"
                                  Data="{StaticResource GeoCard}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Padding="7,0"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenTransferCommand}"
                            AutomationProperties.Name="Export or import configurations"
                            ToolTip="Export or import configurations">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource ToolbarIconStyle}"
                                  Data="{StaticResource GeoTransfer}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Padding="7,0"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenSettingsCommand}"
                            AutomationProperties.Name="Settings"
                            ToolTip="Settings">
                        <Viewbox Width="15" Height="15">
                            <Path Style="{StaticResource ToolbarIconStyle}"
                                  Data="{StaticResource GeoGear}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             Body: library on the left, detail and sessions on the right
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316" MinWidth="280" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ==================================================== library -->
            <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,8">
                    <RadioButton Style="{StaticResource FilterChipStyle}"
                                 GroupName="LibraryFilter"
                                 Content="All"
                                 IsChecked="{Binding Filter, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=All}" />
                    <RadioButton Style="{StaticResource FilterChipStyle}"
                                 GroupName="LibraryFilter"
                                 Content="Favourites"
                                 IsChecked="{Binding Filter, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Favorites}" />
                    <RadioButton Style="{StaticResource FilterChipStyle}"
                                 GroupName="LibraryFilter"
                                 Content="Connected"
                                 IsChecked="{Binding Filter, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Connected}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <TreeView x:Name="LibraryTree"
                              Style="{StaticResource LibraryTreeStyle}"
                              Margin="6,0,4,0"
                              ItemsSource="{Binding Nodes}"
                              ItemContainerStyle="{StaticResource NodeContainerStyle}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <TreeView.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ActivateNodeCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
                            <KeyBinding Key="F2" Command="{Binding RenameSelectedCommand}" />
                        </TreeView.InputBindings>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}"
                                                      ItemContainerStyle="{StaticResource NodeContainerStyle}">
                                <Grid>
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding ActivateCommand}"
                                                      CommandParameter="{Binding}" />
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="4"
                                            Margin="0,2,7,2"
                                            CornerRadius="2"
                                            SnapsToDevicePixels="True"
                                            Background="{Binding Color, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                            Visibility="{Binding HasColor, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />

                                    <Viewbox Grid.Column="1" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path x:Name="NodeIcon" Style="{StaticResource NodeIconStyle}" />
                                    </Viewbox>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Subtitle}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                                    <Viewbox Grid.Column="4"
                                             Width="11"
                                             Height="11"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding Favorite, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <Path Data="{StaticResource GeoStar}" Fill="{StaticResource WarningBrush}" />
                                    </Viewbox>

                                    <Ellipse Grid.Column="5"
                                             Width="7"
                                             Height="7"
                                             Margin="8,0,3,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource SuccessBrush}"
                                             Visibility="{Binding IsRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                                </Grid>

                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter TargetName="NodeIcon" Property="Path.Data" Value="{StaticResource GeoFolder}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMultiConfig}" Value="True">
                                        <Setter TargetName="NodeIcon" Property="Path.Data" Value="{StaticResource GeoLayers}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="NodeIcon" Property="Shape.Stroke" Value="{StaticResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Margin="24,40,24,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="The library is empty. Create a connection to get started."
                               Visibility="{Binding Nodes.Count, Converter={x:Static conv:CountToVisibilityConverter.Instance}, ConverterParameter=invert}" />

                    <TextBlock Margin="24,40,24,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Nothing matches the current search or filter."
                               Visibility="{Binding ShowNoResults, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,1,0,0"
                        Padding="14,7"
                        SnapsToDevicePixels="True">
                    <TextBlock Text="{Binding TreeSummary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrushSoft}"
                          ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          FocusVisualStyle="{x:Null}" />

            <!-- =========================================== detail + sessions -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Connection detail -->
                <ScrollViewer Grid.Row="0"
                              Style="{StaticResource AppScrollViewerStyle}"
                              Padding="24,20,24,20"
                              Visibility="{Binding ShowConnectionDetail, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,4"
                                   Text="{Binding DetailKind}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4"
                                    Height="24"
                                    Margin="0,0,10,0"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{Binding DetailColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                    Visibility="{Binding DetailColor, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding DetailName}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding DetailFavorite, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <Path Data="{StaticResource GeoStar}" Fill="{StaticResource WarningBrush}" />
                            </Viewbox>
                            <Border Style="{StaticResource StatusPillStyle}"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding DetailRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="Running"
                                               Margin="6,0,0,0"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding DetailAddress}"
                                   Margin="0,6,0,0"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Text="{Binding DetailBreadcrumb}"
                                   Margin="0,4,0,0"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding DetailDescription}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding DetailDescription, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Connect"
                                    MinWidth="120"
                                    Command="{Binding ConnectSelectedCommand}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="Edit"
                                    Command="{Binding EditSelectedCommand}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="Duplicate"
                                    Command="{Binding DuplicateSelectedCommand}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="Export .rdp"
                                    Command="{Binding ExportSelectedCommand}" />
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Margin="8,0,0,0"
                                    MinWidth="88"
                                    Content="Favourite"
                                    Command="{Binding ToggleFavoriteCommand}" />
                            <Button Style="{StaticResource DangerButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="Delete"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CREDENTIAL" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding DetailCredential}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,14">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DISPLAY" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding DetailDisplay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LAST CONNECTED" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}"
                                               Text="{Binding DetailLastConnectedUtc, Converter={x:Static conv:RelativeTimeConverter.Instance}}"
                                               Visibility="{Binding DetailLastConnectedUtc, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="Never"
                                               Visibility="{Binding DetailLastConnectedUtc, Converter={x:Static conv:NullToVisibilityConverter.Instance}, ConverterParameter=invert}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,14">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="LAUNCHES" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}" Text="{Binding DetailLaunchCount}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Visibility="{Binding DetailTags, Converter={x:Static conv:StringToVisibilityConverter.Instance}}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="TAGS" />
                                    <TextBlock Style="{StaticResource FieldValueStyle}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Text="{Binding DetailTags}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Multi-config detail -->
                <Grid Grid.Row="0"
                      Margin="24,20,24,20"
                      Visibility="{Binding ShowMultiDetail, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="4"
                                Height="24"
                                Margin="0,0,10,0"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{Binding DetailColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                Visibility="{Binding DetailColor, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding DetailName}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Style="{StaticResource StatusPillStyle}"
                                Margin="12,0,0,0"
                                Visibility="{Binding DetailRunning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" />
                                <TextBlock Text="Running"
                                           Margin="6,0,0,0"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding MultiSummary}"
                                   Margin="0,6,0,0"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DetailBreadcrumb}"
                                   Margin="0,4,0,0"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DetailDescription}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding DetailDescription, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,14">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Launch all"
                                MinWidth="120"
                                Command="{Binding LaunchMultiCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Content="Close all"
                                Command="{Binding CloseMultiCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Content="Edit"
                                Command="{Binding EditSelectedCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Content="Duplicate"
                                Command="{Binding DuplicateSelectedCommand}" />
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Margin="8,0,0,0"
                                Content="Delete"
                                Command="{Binding DeleteSelectedCommand}" />
                    </StackPanel>

                    <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="8">
                        <ListBox Style="{StaticResource ScrollingListBoxStyle}"
                                 ItemsSource="{Binding MultiItems}"
                                 ItemContainerStyle="{StaticResource MultiItemContainerStyle}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Order}"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextMutedBrush}" />

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Address}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Target}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource StatusPillStyle}"
                                                    Visibility="{Binding StateText, Converter={x:Static conv:StringToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{Binding StateText}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusPillStyle}"
                                                    Margin="6,0,0,0"
                                                    Visibility="{Binding Enabled, Converter={x:Static conv:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                                                <TextBlock Text="Disabled"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!-- Group detail -->
                <Grid Grid.Row="0"
                      Margin="24,20,24,20"
                      VerticalAlignment="Top"
                      Visibility="{Binding ShowGroupDetail, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4"
                                    Height="24"
                                    Margin="0,0,10,0"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{Binding DetailColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"
                                    Visibility="{Binding DetailColor, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />
                            <TextBlock Text="{Binding DetailName}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding DetailGroupSummary}"
                                   Margin="0,6,0,0"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <TextBlock Text="{Binding DetailBreadcrumb}"
                                   Margin="0,4,0,0"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding DetailDescription}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding DetailDescription, Converter={x:Static conv:StringToVisibilityConverter.Instance}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="New connection"
                                    MinWidth="140"
                                    Command="{Binding NewConnectionCommand}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="New group"
                                    Command="{Binding NewGroupCommand}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="Rename"
                                    Command="{Binding RenameSelectedCommand}" />
                            <Button Style="{StaticResource DangerButtonStyle}"
                                    Margin="8,0,0,0"
                                    Content="Delete"
                                    Command="{Binding DeleteSelectedCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Empty state -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyState, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                    <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
                        <Path Style="{StaticResource ToolbarIconStyle}"
                              Data="{StaticResource GeoMonitor}"
                              Stroke="{StaticResource TextMutedBrush}" />
                    </Viewbox>
                    <TextBlock Text="DYNATEC Remote Desktop Manager"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="Pick something on the left, or create a connection."
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,20,0,0"
                            MinWidth="160"
                            HorizontalAlignment="Center"
                            Content="New connection"
                            Command="{Binding NewConnectionCommand}" />
                </StackPanel>

                <!-- ========================================== session strip -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,1,0,0"
                        SnapsToDevicePixels="True"
                        Visibility="{Binding Sessions.Count, Converter={x:Static conv:CountToVisibilityConverter.Instance}}">
                    <StackPanel Margin="16,10,16,12">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="LIVE SESSIONS" />

                        <ListBox Style="{StaticResource ScrollingListBoxStyle}"
                                 MaxHeight="150"
                                 ItemsSource="{Binding Sessions}"
                                 ItemContainerStyle="{StaticResource SessionCardItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}"
                                            Width="264"
                                            Padding="12,10"
                                            Background="{StaticResource SurfaceAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Style="{StaticResource StatusPillStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding State, Converter={x:Static conv:SessionStateToBrushConverter.Instance}}" />
                                                        <TextBlock Text="{Binding StateText}"
                                                                   Margin="6,0,0,0"
                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextMutedBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{x:Static vm:MainWindowUptimeConverter.Instance}">
                                                            <Binding Path="StartedUtc" />
                                                            <Binding Path="EndedUtc" />
                                                            <Binding Path="DataContext.Clock"
                                                                     RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Host}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Style="{StaticResource CompactButtonStyle}"
                                                        Content="Focus"
                                                        Command="{Binding DataContext.FocusSessionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CompactButtonStyle}"
                                                        Margin="6,0,0,0"
                                                        Content="Reconnect"
                                                        Command="{Binding DataContext.ReconnectSessionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CompactButtonStyle}"
                                                        Margin="6,0,0,0"
                                                        Content="Close"
                                                        Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
